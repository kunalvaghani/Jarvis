{
  "manifest_version": 3,
  "name": "Jarvis Browser",
  "version": "0.2.0",
  "description": "Lets Jarvis work in your Chrome, only inside its own \"Jarvis\" tab group.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Jarvis Browser"
  },
  "key": ""
}
