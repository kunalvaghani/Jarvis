@@ -0,0 +1,111 @@
+"""Versioned, de-duplicated AZR task datasets with leak-proof train/validation/held-out splits.
+
+* Splits are fixed by **disjoint seed ranges and disjoint structure signatures**: a structure skeleton
+  (tool sequence or program family + constant) that appears in one split never appears in another,
+  so near-duplicates cannot leak between training and evaluation.
+* Exact duplicates are removed by task id (content hash); near-duplicates by signature.
+* Every record carries provenance: generator, seed, environment/oracle versions, and how its answer
+  was obtained (always the deterministic environment or a Jarvis-authored oracle program, never a model).
+* Model answers and their verification are stored next to the tasks; incorrect answers are kept for
+  analysis but are never written back as ground truth.
+"""
+from datetime import datetime, timezone
+import hashlib
+import json
+from pathlib import Path
+
+from .azr_tasks import ENV_VERSION, ORACLE_VERSION, abduction_task, deduction_task, induction_task, signature, task_id
+
+SCHEMA_VERSION = 1
+SPLITS = ('train', 'validation', 'heldout')
+# Disjoint seed ranges per split; the held-out range is reserved for the sealed evaluator.
+SEED_RANGES = {'train': (10_000, 60_000), 'validation': (60_000, 70_000), 'heldout': (900_000, 910_000)}
+GENERATORS = {'deduction': deduction_task, 'abduction': abduction_task, 'induction': induction_task}
+# Program families reserved for the held-out split test generalization to unseen induction families.
+HELDOUT_FAMILIES = {'initials', 'rotate_k', 'count_k'}
+
+
+def generate(split, counts, reserved_signatures=frozenset(), max_tries=20000):
+    """counts: {mode: n}. Returns curated tasks plus a curation report (duplicates and leakage rejected)."""
+    low, high = SEED_RANGES[split]
+    tasks, ids, signatures = [], set(), {}
+    report = {'split': split, 'exact_duplicates': 0, 'reserved_signature_rejected': 0, 'near_duplicate_rejected': 0}
+    for mode, wanted in counts.items():
+        made, seed = 0, low + {'deduction': 0, 'abduction': 15_000, 'induction': 30_000}[mode] % (high - low)
+        tries = 0
+        while made < wanted and tries < max_tries:
+            tries += 1
+            seed += 1
+            if seed >= high:
+                seed = low
+            if mode == 'induction':
+                families = HELDOUT_FAMILIES if split == 'heldout' else None
+                task = induction_task(seed, families)
+                if split != 'heldout' and task['family'] in HELDOUT_FAMILIES:
+                    continue
+            else:
+                task = GENERATORS[mode](seed)
+            identifier, skeleton = task_id(task), signature(task)
+            if identifier in ids:
+                report['exact_duplicates'] += 1
+                continue
+            if skeleton in reserved_signatures:
+                report['reserved_signature_rejected'] += 1
+                continue
+            if signatures.get(skeleton, 0) >= (3 if mode == 'induction' else 1):
+                report['near_duplicate_rejected'] += 1
+                continue
+            ids.add(identifier)
+            signatures[skeleton] = signatures.get(skeleton, 0) + 1
+            tasks.append({'schema_version': SCHEMA_VERSION, 'id': identifier, 'split': split, 'signature': skeleton,
+                          'task': task, 'provenance': {
+                              'generator': 'jarvis.azr_tasks.' + GENERATORS[mode].__name__, 'seed': task['seed'],
+                              'env_version': ENV_VERSION, 'oracle_version': ORACLE_VERSION,
+                              'answer_source': 'deterministic simulation' if mode != 'induction'
+                              else 'Jarvis-authored template program executed twice'}})
+            made += 1
+        report[mode] = made
+    return tasks, report
+
+
+def build(counts_by_split):
+    """Generate held-out first, then validation, then train, each excluding earlier signatures."""
+    datasets, reports, reserved = {}, {}, set()
+    for split in ('heldout', 'validation', 'train'):
+        tasks, report = generate(split, counts_by_split[split], frozenset(reserved))
+        datasets[split], reports[split] = tasks, report
+        reserved |= {t['signature'] for t in tasks}
+    leaks = {}
+    for a in SPLITS:
+        for b in SPLITS:
+            if a < b:
+                shared = {t['signature'] for t in datasets[a]} & {t['signature'] for t in datasets[b]}
+                shared_ids = {t['id'] for t in datasets[a]} & {t['id'] for t in datasets[b]}
+                leaks[a + '/' + b] = {'signatures': len(shared), 'ids': len(shared_ids)}
+    return datasets, {'reports': reports, 'leakage': leaks}
+
+
+def write(folder, datasets, meta):
+    folder = Path(folder)
+    if folder.exists():
+        raise FileExistsError('Refusing to overwrite a versioned dataset: ' + str(folder))
+    folder.mkdir(parents=True)
+    hashes = {}
+    for split, tasks in datasets.items():
+        body = ''.join(json.dumps(t, sort_keys=True) + '\n' for t in tasks)
+        (folder / (split + '.jsonl')).write_text(body, encoding='utf-8')
+        hashes[split] = hashlib.sha256(body.encode()).hexdigest()
+    manifest = {'schema_version': SCHEMA_VERSION, 'created_at': datetime.now(timezone.utc).isoformat(timespec='seconds'),
+                'env_version': ENV_VERSION, 'oracle_version': ORACLE_VERSION, 'sha256': hashes,
+                'counts': {s: len(t) for s, t in datasets.items()}, **meta}
+    (folder / 'manifest.json').write_text(json.dumps(manifest, indent=1), encoding='utf-8')
+    return manifest
+
+
+def load(folder, split):
+    folder = Path(folder)
+    manifest = json.loads((folder / 'manifest.json').read_text(encoding='utf-8'))
+    body = (folder / (split + '.jsonl')).read_text(encoding='utf-8')
+    if hashlib.sha256(body.encode()).hexdigest() != manifest['sha256'][split]:
+        raise ValueError('Dataset file does not match its manifest hash: ' + split)
+    return [json.loads(line) for line in body.splitlines() if line.strip()]
diff --git a/app/jarvis/azr_proposer.py b/app/jarvis/azr_proposer.py
new file mode 100644
index 0000000..e29b55f
--- /dev/null
+++ b/app/jarvis/azr_proposer.py
@@ -0,0 +1,154 @@
+"""AZR-style proposer with learnability scoring, using local models only (Pillar D).
+
+The proposer (default local ``qwen3.5:9b``) writes a *task*, never an answer: a deduction scenario
+(initial state + calls) or an induction program with inputs. The independent oracle then validates
+it and computes the answer: the simulation executes calls; induction programs are statically
+screened and executed twice in the sandbox (AZR integrity, safety and determinism checks).
+Learnability follows AZR: r_propose = 1 - mean solve rate over G solver rollouts, and 0 when
+the task is never or always solved. Proposals that fail validation receive the AZR format
+penalty (-1) and are kept only in the rejection log, never in a dataset.
+"""
+import json
+import random
+import urllib.request
+
+from .azr_tasks import (APPS, TOOLS, canonical, check_abduction, check_deduction, execute, extract_code, parse_json_answer,
+                        render_prompt, screen_program, with_dependencies)
+
+OLLAMA = 'http://127.0.0.1:11434/api/generate'
+
+
+def ollama(model, prompt, temperature=0.0, seed=0, num_predict=512, system=None, timeout=600):
+    body = {'model': model, 'prompt': prompt, 'stream': False, 'think': False,
+            'options': {'temperature': temperature, 'seed': seed, 'num_predict': num_predict}}
+    if system:
+        body['system'] = system
+    request = urllib.request.Request(OLLAMA, json.dumps(body).encode(), {'Content-Type': 'application/json'})
+    with urllib.request.urlopen(request, timeout=timeout) as response:
+        return json.loads(response.read())['response']
+
+
+PROPOSE_DEDUCTION = ('Propose one new practice scenario for a simulated computer. Reply with JSON only: '
+                     '{"initial": {"files": {"folder/name.txt": "short text"}, "apps": [], "clipboard": ""}, '
+                     '"calls": [{"id": "s1", "tool": "...", "args": {...}}]}. Use 2-6 calls with these tools and exact '
+                     'argument names: ' + ', '.join(f'{name}({", ".join(spec[0])})' for name, spec in TOOLS.items()) +
+                     '. Apps must be among: ' + ', '.join(APPS) + '. Paths are short like docs/notes.txt. '
+                     'Make it tricky but unambiguous. Earlier examples: {references}')
+PROPOSE_INDUCTION = ('Propose one small pure Python function f(x) and 8 different inputs for it. x is a list of integers '
+                     'or a short string. No imports, no while loops, no randomness. Reply with JSON only: '
+                     '{"message": "one-line description", "source": "def f(x):\\n    ...", "inputs": [...]}. '
+                     'Earlier examples: {references}')
+
+
+def validate_deduction(proposal):
+    """Oracle validation: schema, tools, then execute; the answer is computed, never taken from the model."""
+    initial = proposal.get('initial')
+    calls = proposal.get('calls')
+    if not isinstance(initial, dict) or not isinstance(calls, list) or not 1 <= len(calls) <= 8:
+        raise ValueError('schema')
+    files = initial.get('files', {})
+    if (not isinstance(files, dict) or len(files) > 6 or any(not isinstance(k, str) or not isinstance(v, str)
+                                                           or len(k) > 60 or len(v) > 120 for k, v in files.items())):
+        raise ValueError('files')
+    apps = initial.get('apps', [])
+    if not isinstance(apps, list) or any(a not in APPS for a in apps):
+        raise ValueError('apps')
+    state = canonical({'files': files, 'apps': apps, 'clipboard': str(initial.get('clipboard', ''))[:120]})
+    clean = []
+    for index, call in enumerate(calls):
+        if not isinstance(call, dict) or call.get('tool') not in TOOLS or not isinstance(call.get('args'), dict):
+            raise ValueError('call')
+        if set(call['args']) != set(TOOLS[call['tool']][0]) or not all(isinstance(v, str) and len(v) <= 120
+                                                                        for v in call['args'].values()):
+            raise ValueError('arguments')
+        clean.append({'id': f's{index + 1}', 'tool': call['tool'], 'args': call['args']})
+    first = execute(state, clean)
+    if execute(state, clean) != first:
+        raise ValueError('nondeterministic')
+    return {'mode': 'deduction', 'seed': None, 'initial': state, 'calls': clean, 'answer': first}
+
+
+def abduction_from(deduction):
+    """A deduction scenario that runs to completion also yields an abduction task (desired = final state)."""
+    if deduction['answer']['halted']:
+        return None
+    desired = {k: deduction['answer'][k] for k in ('files', 'apps', 'clipboard')}
+    if desired == deduction['initial']:
+        return None
+    plan = with_dependencies([{**c, 'deps': []} for c in deduction['calls']])
+    task = {'mode': 'abduction', 'seed': None, 'initial': deduction['initial'], 'desired': desired, 'reference_plan': plan}
+    if not check_abduction(task, json.dumps(plan))['correct']:
+        return None
+    return task
+
+
+def validate_induction(proposal, base, run_programs):
+    source = proposal.get('source')
+    inputs = proposal.get('inputs')
+    message = str(proposal.get('message', ''))[:160]
+    if not isinstance(source, str) or not isinstance(inputs, list) or not 6 <= len(inputs) <= 12:
+        raise ValueError('schema')
+    screen_program(source)
+    if any(not (isinstance(v, str) and len(v) <= 60 or isinstance(v, list) and len(v) <= 10
+                and all(type(i) is int and -10 ** 6 < i < 10 ** 6 for i in v)) for v in inputs):
+        raise ValueError('inputs')
+    unique = list({json.dumps(v): v for v in inputs}.values())
+    # Outputs come from sandboxed execution (twice), not from the proposer.
+    probe = run_programs(base, [{'id': 'probe', 'source': source, 'cases': [{'input': v, 'output': None} for v in unique]}])
+    row = probe['probe']
+    if row.get('error') or not row.get('cases') or not row.get('deterministic', True):
+        raise ValueError('execution failed: ' + str(row.get('error') or row.get('screen')))
+    return {'program': source, 'message': message, 'inputs': unique}
+
+
+class Proposer:
+    def __init__(self, base, proposer='qwen3.5:9b', solver='qwen3.5:0.8b', rollouts=4, seed=0):
+        self.base, self.proposer, self.solver, self.rollouts = base, proposer, solver, rollouts
+        self.rng = random.Random(seed)
+        self.rejections = []
+
+    def learnability(self, task):
+        """AZR: r_propose = 0 if mean solve rate is 0 or 1, else 1 - mean solve rate (G solver rollouts)."""
+        from .azr_tasks import SYSTEM
+        solved = []
+        for rollout in range(self.rollouts):
+            text = ollama(self.solver, render_prompt(task), temperature=.7, seed=1000 + rollout, num_predict=600, system=SYSTEM)
+            check = check_deduction(task, text) if task['mode'] == 'deduction' else check_abduction(task, text)
+            solved.append(bool(check['correct']))
+        rate = sum(solved) / len(solved)
+        return {'solve_rate': rate, 'r_propose': 0.0 if rate in (0.0, 1.0) else round(1 - rate, 4), 'rollouts': len(solved)}
+
+    def propose_deduction(self, references):
+        prompt = PROPOSE_DEDUCTION.replace('{references}', json.dumps(references[:2]))
+        text = ollama(self.proposer, prompt, temperature=.8, seed=self.rng.randint(1, 10 ** 6), num_predict=700)
+        try:
+            task = validate_deduction(parse_json_answer(text))
+        except (ValueError, TypeError, KeyError, AttributeError) as exc:
+            self.rejections.append({'mode': 'deduction', 'reason': str(exc)[:80], 'format_reward': -1})
+            return None
+        task['provenance'] = {'proposer': self.proposer, 'answer_source': 'deterministic simulation'}
+        return task
+
+    def propose_induction(self, references, run_programs, visible=4):
+        prompt = PROPOSE_INDUCTION.replace('{references}', json.dumps(references[:2]))
+        text = ollama(self.proposer, prompt, temperature=.8, seed=self.rng.randint(1, 10 ** 6), num_predict=500)
+        try:
+            proposal = parse_json_answer(text)
+            checked = validate_induction(proposal, self.base, run_programs)
+        except (ValueError, TypeError, KeyError, AttributeError, SyntaxError, RuntimeError) as exc:
+            self.rejections.append({'mode': 'induction', 'reason': str(exc)[:80], 'format_reward': -1})
+            return None
+        # Execute once more in the sandbox to obtain outputs (never trusting the proposer).
+        rows = run_programs(self.base, [{'id': 'outputs', 'source': checked['program'],
+                                          'cases': [{'input': v, 'output': None} for v in checked['inputs']]}])
+        if rows['outputs'].get('error'):
+            self.rejections.append({'mode': 'induction', 'reason': 'output pass failed', 'format_reward': -1})
+            return None
+        outputs = [case.get('output') for case in rows['outputs']['cases']]
+        if len(outputs) != len(checked['inputs']) or any(o is None for o in outputs):
+            self.rejections.append({'mode': 'induction', 'reason': 'non-JSON output', 'format_reward': -1})
+            return None
+        cases = [{'input': v, 'output': o} for v, o in zip(checked['inputs'], outputs)]
+        return {'mode': 'induction', 'seed': None, 'family': 'proposed', 'k': None, 'message': checked['message'],
+                'visible': cases[:visible], 'hidden': cases[visible:], 'reference_source': extract_code(checked['program']),
+                'provenance': {'proposer': self.proposer, 'answer_source': 'sandbox execution (twice) of the proposed program'}}
diff --git a/app/jarvis/azr_reward.py b/app/jarvis/azr_reward.py
new file mode 100644
index 0000000..528edb3
--- /dev/null
+++ b/app/jarvis/azr_reward.py
@@ -0,0 +1,60 @@
+"""Independent verifiable rewards for AZR answers (Pillar D, Part C).
+
+Rewards are computed only from the oracle: the deterministic simulation (deduction, abduction)
+and sandboxed execution (induction). The reward code never imports or reads candidate training
+outputs other than the answer text it scores. AZR's composite reward is used:
+correct = 1, well-formatted but wrong = -0.5, format/safety failure = -1.
+Induction also reports visible-only passes, so memorising the shown examples cannot score as
+generalisation, and repeatability (every case is executed twice).
+"""
+from .azr_tasks import check_abduction, check_deduction, extract_code, screen_program
+
+CORRECT, WRONG, MALFORMED = 1.0, -0.5, -1.0
+
+
+def score_symbolic(task, answer):
+    check = check_deduction(task, answer) if task['mode'] == 'deduction' else check_abduction(task, answer)
+    reward = CORRECT if check['correct'] else WRONG if check['format_ok'] else MALFORMED
+    return {**check, 'reward': reward}
+
+
+def score_induction_batch(base, items, run_programs):
+    """items: [(key, task, answer_text)] -> {key: result}; one sandbox run for the whole batch."""
+    programs, results = [], {}
+    for key, task, answer in items:
+        source = extract_code(answer)
+        try:
+            screen_program(source)
+        except (ValueError, SyntaxError) as exc:
+            results[key] = {'format_ok': False, 'correct': False, 'reason': 'screen: ' + str(exc)[:80], 'reward': MALFORMED}
+            continue
+        programs.append({'id': key + ':visible', 'source': source, 'cases': task['visible']})
+        programs.append({'id': key + ':hidden', 'source': source, 'cases': task['hidden']})
+    if programs:
+        rows = run_programs(base, programs)
+        for key, task, _ in items:
+            if key in results:
+                continue
+            visible, hidden = rows[key + ':visible'], rows[key + ':hidden']
+            correct = bool(visible['passed'] and hidden['passed'])
+            results[key] = {'format_ok': True, 'correct': correct, 'visible_passed': bool(visible['passed']),
+                            'hidden_passed': bool(hidden['passed']),
+                            'deterministic': bool(visible.get('deterministic') and hidden.get('deterministic')),
+                            'error': visible.get('error') or hidden.get('error'),
+                            'reason': 'generalizes' if correct else ('visible_only' if visible['passed'] else 'fails_visible'),
+                            'reward': CORRECT if correct else WRONG}
+    return results
+
+
+def score_all(base, rows, run_programs):
+    """rows: [{key, task, answer}] -> {key: result} for every mode."""
+    results = {}
+    induction = []
+    for row in rows:
+        if row['task']['mode'] == 'induction':
+            induction.append((row['key'], row['task'], row['answer']))
+        else:
+            results[row['key']] = score_symbolic(row['task'], row['answer'])
+    for start in range(0, len(induction), 40):
+        results.update(score_induction_batch(base, induction[start:start + 40], run_programs))
+    return results
diff --git a/app/jarvis/azr_sandbox.py b/app/jarvis/azr_sandbox.py
new file mode 100644
index 0000000..a5db829
--- /dev/null
+++ b/app/jarvis/azr_sandbox.py
@@ -0,0 +1,128 @@
+"""Restricted execution of induction answers (model-written Python) for the AZR oracle.
+
+Model code is never executed in the Jarvis process. Each batch runs in the reviewed MCP runtime
+container (no network, read-only root, no capabilities, non-root, PID/memory/CPU limits and a
+lifetime fence; see ``mcp_synthesis.server_config``) behind a Jarvis-owned harness. The harness
+forks one child per program with restricted builtins and OS limits (CPU seconds, address space,
+no core files) and kills it after a wall-clock deadline, so a runaway C-level loop or allocation
+loses only that program. Every case is run twice so nondeterministic programs fail (AZR's
+determinism check). The static screen (``azr_tasks.screen_program``) runs first; passing it is not
+treated as proof of safety.
+"""
+import json
+from pathlib import Path
+import subprocess
+import uuid
+
+from .azr_tasks import SAFE_BUILTINS, screen_program
+
+HARNESS = r'''
+import builtins, json, os, resource, select, signal, sys, time
+SAFE = set(json.loads(sys.argv[1]))
+spec = json.loads(sys.stdin.read())
+
+def evaluate(program):
+    allowed = {name: getattr(builtins, name) for name in SAFE}
+    namespace = {"__builtins__": allowed}
+    row = {"id": program["id"], "cases": []}
+    try:
+        exec(compile(program["source"], "answer", "exec"), namespace)
+        function = namespace["f"]
+        for case in program["cases"]:
+            outputs = []
+            for _ in range(2):
+                value = case["input"]
+                value = list(value) if isinstance(value, list) else value
+                outputs.append(function(value))
+            try:
+                shown = json.loads(json.dumps(outputs[0]))
+            except (TypeError, ValueError):
+                shown = None
+            expected = case["output"]
+            row["cases"].append({"ok": outputs[0] == outputs[1] and (expected is None or outputs[0] == expected),
+                                 "deterministic": outputs[0] == outputs[1], "output": shown})
+    except BaseException as error:
+        row["error"] = type(error).__name__
+    return row
+
+results = []
+for program in spec["programs"]:
+    read_end, write_end = os.pipe()
+    pid = os.fork()
+    if pid == 0:
+        os.close(read_end)
+        resource.setrlimit(resource.RLIMIT_CPU, (2, 2))
+        resource.setrlimit(resource.RLIMIT_AS, (160 * 2 ** 20, 160 * 2 ** 20))
+        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+        data = json.dumps(evaluate(program)).encode()
+        os.write(write_end, data[:2 ** 20])
+        os._exit(0)
+    os.close(write_end)
+    chunks, deadline = [], time.monotonic() + 5
+    while True:
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            break
+        ready, _, _ = select.select([read_end], [], [], remaining)
+        if not ready:
+            break
+        chunk = os.read(read_end, 65536)
+        if not chunk:
+            break
+        chunks.append(chunk)
+    os.close(read_end)
+    try:
+        os.kill(pid, signal.SIGKILL)
+    except ProcessLookupError:
+        pass
+    _, status = os.waitpid(pid, 0)
+    try:
+        row = json.loads(b"".join(chunks))
+    except ValueError:
+        row = {"id": program["id"], "cases": [], "error": "killed_by_limit"}
+    results.append(row)
+print(json.dumps(results))
+'''
+
+
+class SandboxUnavailable(RuntimeError):
+    pass
+
+
+def run_programs(base, programs, cancelled=lambda: False, timeout=120):
+    """programs: [{id, source, cases:[{input, output}]}]. Screen first; execute only in the container."""
+    from .mcp_synthesis import image_status, reap, server_config
+    screened, results = [], {}
+    for program in programs:
+        try:
+            screen_program(program['source'])
+            screened.append(program)
+        except (ValueError, SyntaxError) as exc:
+            results[program['id']] = {'passed': False, 'screen': 'rejected: ' + str(exc)[:120], 'cases': []}
+    if not screened:
+        return results
+    status = image_status(cancelled)
+    if not status['available']:
+        raise SandboxUnavailable(status['reason'])
+    folder = Path(base) / '.jarvis-runtime' / 'azr' / 'sandbox' / uuid.uuid4().hex[:12]
+    folder.mkdir(parents=True, exist_ok=True)
+    (folder / 'server.py').write_text(HARNESS, encoding='utf-8')
+    name = 'gen-azr-' + folder.name
+    config = server_config(name, folder, 'azr', status['image_id'], timeout)
+    args = [*config['args'], json.dumps(sorted(SAFE_BUILTINS))]
+    try:
+        completed = subprocess.run([config['command'], *args], input=json.dumps({'programs': screened}),
+                                   capture_output=True, text=True, timeout=timeout + 30)
+    finally:
+        reap(name)
+    try:
+        rows = json.loads(completed.stdout.strip().splitlines()[-1])
+    except (ValueError, IndexError):
+        raise SandboxUnavailable('sandbox produced no result: ' + completed.stderr[-300:]) from None
+    for row in rows:
+        cases = row.get('cases', [])
+        results[row['id']] = {'passed': not row.get('error') and bool(cases) and all(c['ok'] for c in cases)
+                              and len(cases) == len(next(p for p in screened if p['id'] == row['id'])['cases']),
+                              'screen': 'passed', 'error': row.get('error'), 'cases': cases,
+                              'deterministic': all(c['deterministic'] for c in cases) if cases else None}
+    return results
diff --git a/app/jarvis/azr_tasks.py b/app/jarvis/azr_tasks.py
new file mode 100644
index 0000000..d038b71
--- /dev/null
+++ b/app/jarvis/azr_tasks.py
@@ -0,0 +1,431 @@
+"""Absolute Zero-style synthetic reasoning tasks over a disposable computer state (Pillar D).
+
+Adapted from the method of Absolute Zero (LeapLabTHU/Absolute-Zero-Reasoner, MIT; arXiv 2505.03335):
+tasks come in three modes and every answer is judged by execution, never by a model:
+
+* DEDUCTION  given an initial state and a tool-call sequence, predict the exact final state
+             (trains state-transition prediction for ``cognition.predict``);
+* ABDUCTION  given an initial and a desired state, produce a dependency-respecting tool-call DAG
+             that reaches it (trains planning/tool selection for ``brain.py``); any DAG whose every
+             valid execution order reaches the desired state is correct;
+* INDUCTION  given visible input/output examples, write a Python function that also passes hidden
+             cases (trains small capability generation for ``repo_abilities``).
+
+The environment is a pure, in-memory simulation: no real file, window or clipboard is touched.
+No AZR code is copied; the AZR executor is described upstream as research-only and is not used.
+"""
+import ast
+import copy
+import hashlib
+import itertools
+import json
+import random
+import re
+
+ENV_VERSION = 1
+ORACLE_VERSION = 1
+MAX_CALLS = 12
+TOOLS = {
+    # name: (argument names, reads(args), writes(args))
+    'create_file': (('path', 'content'), lambda a: [], lambda a: ['file:' + a['path']]),
+    'append_file': (('path', 'text'), lambda a: ['file:' + a['path']], lambda a: ['file:' + a['path']]),
+    'replace_text': (('path', 'old', 'new'), lambda a: ['file:' + a['path']], lambda a: ['file:' + a['path']]),
+    'copy_file': (('src', 'dst'), lambda a: ['file:' + a['src']], lambda a: ['file:' + a['dst']]),
+    'move_file': (('src', 'dst'), lambda a: ['file:' + a['src']], lambda a: ['file:' + a['src'], 'file:' + a['dst']]),
+    'delete_file': (('path',), lambda a: ['file:' + a['path']], lambda a: ['file:' + a['path']]),
+    'open_app': (('app',), lambda a: [], lambda a: ['app:' + a['app']]),
+    'close_app': (('app',), lambda a: ['app:' + a['app']], lambda a: ['app:' + a['app']]),
+    'copy_text': (('path',), lambda a: ['file:' + a['path']], lambda a: ['clipboard']),
+    'paste_append': (('path',), lambda a: ['clipboard', 'file:' + a['path']], lambda a: ['file:' + a['path']]),
+}
+NAMES = ('notes', 'todo', 'report', 'draft', 'plan', 'log', 'ideas', 'budget', 'readme', 'summary')
+FOLDERS = ('docs', 'work', 'home', 'archive', 'tmp')
+WORDS = ('alpha', 'beta', 'gamma', 'delta', 'red', 'blue', 'green', 'one', 'two', 'three', 'done', 'open')
+APPS = ('notepad', 'calculator', 'browser', 'editor', 'player')
+
+
+class ExecutionError(Exception):
+    def __init__(self, step, reason):
+        super().__init__(f'{step}: {reason}')
+        self.step, self.reason = step, reason
+
+
+def canonical(state):
+    return {'files': dict(sorted(state['files'].items())), 'apps': sorted(set(state['apps'])),
+            'clipboard': state['clipboard']}
+
+
+def apply(state, call):
+    """Apply one call to a copy of the state; precondition failures raise ExecutionError."""
+    tool, args, step = call['tool'], call['args'], call.get('id', '?')
+    if tool not in TOOLS or set(args) != set(TOOLS[tool][0]) or not all(isinstance(v, str) for v in args.values()):
+        raise ExecutionError(step, 'invalid_call')
+    state = copy.deepcopy(state)
+    files = state['files']
+    def need(path):
+        if path not in files:
+            raise ExecutionError(step, 'missing:' + path)
+    def free(path):
+        if path in files:
+            raise ExecutionError(step, 'exists:' + path)
+    if tool == 'create_file':
+        free(args['path'])
+        files[args['path']] = args['content']
+    elif tool == 'append_file':
+        need(args['path'])
+        files[args['path']] += args['text']
+    elif tool == 'replace_text':
+        need(args['path'])
+        if args['old'] not in files[args['path']] or not args['old']:
+            raise ExecutionError(step, 'text_not_found')
+        files[args['path']] = files[args['path']].replace(args['old'], args['new'], 1)
+    elif tool == 'copy_file':
+        need(args['src'])
+        free(args['dst'])
+        files[args['dst']] = files[args['src']]
+    elif tool == 'move_file':
+        need(args['src'])
+        free(args['dst'])
+        files[args['dst']] = files.pop(args['src'])
+    elif tool == 'delete_file':
+        need(args['path'])
+        del files[args['path']]
+    elif tool == 'open_app':
+        if args['app'] in state['apps']:
+            raise ExecutionError(step, 'already_open:' + args['app'])
+        state['apps'].append(args['app'])
+    elif tool == 'close_app':
+        if args['app'] not in state['apps']:
+            raise ExecutionError(step, 'not_open:' + args['app'])
+        state['apps'].remove(args['app'])
+    elif tool == 'copy_text':
+        need(args['path'])
+        state['clipboard'] = files[args['path']]
+    elif tool == 'paste_append':
+        need(args['path'])
+        files[args['path']] += state['clipboard']
+    return state
+
+
+def execute(state, calls):
+    """Deduction semantics: run calls in order; on the first failure stop and report where."""
+    current = canonical(state)
+    for call in calls:
+        try:
+            current = canonical(apply(current, call))
+        except ExecutionError as exc:
+            return {**current, 'halted': {'step': exc.step, 'reason': exc.reason}}
+    return {**current, 'halted': None}
+
+
+# ---- generators (seeded; the environment computes every answer) --------------------------------------------------------
+def random_state(rng):
+    files = {}
+    for _ in range(rng.randint(1, 4)):
+        path = rng.choice(FOLDERS) + '/' + rng.choice(NAMES) + '.txt'
+        files[path] = ' '.join(rng.sample(WORDS, rng.randint(1, 3)))
+    return canonical({'files': files, 'apps': rng.sample(APPS, rng.randint(0, 2)), 'clipboard': ''})
+
+
+def random_call(rng, state, index, allow_failure):
+    files = sorted(state['files'])
+    fresh = rng.choice(FOLDERS) + '/' + rng.choice(NAMES) + '.txt'
+    options = ['create_file', 'open_app']
+    if files:
+        options += ['append_file', 'replace_text', 'copy_file', 'move_file', 'delete_file', 'copy_text', 'paste_append']
+    if state['apps']:
+        options.append('close_app')
+    tool = rng.choice(options)
+    path = rng.choice(files) if files and not (allow_failure and rng.random() < .15) else fresh
+    if tool == 'create_file':
+        args = {'path': fresh if fresh not in state['files'] or allow_failure else fresh + '.new',
+                'content': rng.choice(WORDS)}
+    elif tool == 'append_file':
+        args = {'path': path, 'text': ' ' + rng.choice(WORDS)}
+    elif tool == 'replace_text':
+        content = state['files'].get(path, '')
+        old = rng.choice(content.split()) if content.split() and rng.random() > .1 else rng.choice(WORDS)
+        args = {'path': path, 'old': old, 'new': rng.choice(WORDS)}
+    elif tool in {'copy_file', 'move_file'}:
+        args = {'src': path, 'dst': fresh}
+    elif tool in {'delete_file', 'copy_text', 'paste_append'}:
+        args = {'path': path}
+    elif tool == 'open_app':
+        args = {'app': rng.choice(APPS)}
+    else:
+        args = {'app': rng.choice(state['apps'])}
+    return {'id': f's{index}', 'tool': tool, 'args': args}
+
+
+def deduction_task(seed, length=None):
+    rng = random.Random(seed)
+    state = random_state(rng)
+    calls, current = [], state
+    for index in range(length or rng.randint(2, 6)):
+        call = random_call(rng, current, index + 1, allow_failure=True)
+        calls.append(call)
+        result = execute(current, [call])
+        if result['halted']:
+            break
+        current = {k: result[k] for k in ('files', 'apps', 'clipboard')}
+    return {'mode': 'deduction', 'seed': seed, 'initial': state, 'calls': calls,
+            'answer': execute(state, calls)}  # oracle-computed, never model-written
+
+
+def abduction_task(seed):
+    """Desired state reached by a hidden valid plan; any other valid DAG reaching it is accepted."""
+    rng = random.Random(seed)
+    for _ in range(50):
+        state = random_state(rng)
+        calls, current = [], state
+        for index in range(rng.randint(2, 5)):
+            call = random_call(rng, current, index + 1, allow_failure=False)
+            result = execute(current, [call])
+            if result['halted']:
+                continue
+            call['id'] = f's{len(calls) + 1}'
+            call['deps'] = []
+            calls.append(call)
+            current = {k: result[k] for k in ('files', 'apps', 'clipboard')}
+        if calls and current != state:
+            plan = with_dependencies(calls)
+            return {'mode': 'abduction', 'seed': seed, 'initial': state, 'desired': canonical(current),
+                    'reference_plan': plan}
+    raise ValueError('Could not generate an abduction task for seed ' + str(seed))
+
+
+def with_dependencies(calls):
+    """Minimal dependency edges for a sequential plan: each call depends on the last earlier conflicting call."""
+    plan = []
+    for index, call in enumerate(calls):
+        deps = []
+        mine_r, mine_w = resources(call)
+        for earlier in reversed(calls[:index]):
+            theirs_r, theirs_w = resources(earlier)
+            if (mine_w & (theirs_r | theirs_w)) or (mine_r & theirs_w):
+                deps.append(earlier['id'])
+        plan.append({**call, 'deps': sorted(set(deps))})
+    return plan
+
+
+def resources(call):
+    _, reads, writes = TOOLS[call['tool']]
+    return set(reads(call['args'])), set(writes(call['args']))
+
+
+PROGRAMS = (
+    # (family, description, source template, input generator name)
+    ('reverse_words', 'reverse the order of words', "def f(x):\n    return ' '.join(reversed(x.split()))\n", 'text'),
+    ('count_vowels', 'count vowels', "def f(x):\n    return sum(1 for c in x.lower() if c in 'aeiou')\n", 'text'),
+    ('title_case', 'capitalize each word', "def f(x):\n    return ' '.join(w[:1].upper() + w[1:] for w in x.split())\n", 'text'),
+    ('sum_even', 'sum of even numbers', "def f(x):\n    return sum(v for v in x if v % 2 == 0)\n", 'ints'),
+    ('running_max', 'running maximum', "def f(x):\n    out, best = [], None\n    for v in x:\n        best = v if best is None or v > best else best\n        out.append(best)\n    return out\n", 'ints'),
+    ('dedupe', 'remove duplicates keeping order', "def f(x):\n    seen, out = set(), []\n    for v in x:\n        if v not in seen:\n            seen.add(v)\n            out.append(v)\n    return out\n", 'ints'),
+    ('pairwise_diff', 'differences of neighbours', "def f(x):\n    return [b - a for a, b in zip(x, x[1:])]\n", 'ints'),
+    ('scale_k', 'multiply each by K', "def f(x):\n    return [v * {K} for v in x]\n", 'ints'),
+    ('shift_k', 'add K to each', "def f(x):\n    return [v + {K} for v in x]\n", 'ints'),
+    ('clip_k', 'clip values at K', "def f(x):\n    return [min(v, {K}) for v in x]\n", 'ints'),
+    ('longest_word', 'longest word (first on ties)', "def f(x):\n    words = x.split()\n    return max(words, key=len) if words else ''\n", 'text'),
+    ('initials', 'initials in upper case', "def f(x):\n    return ''.join(w[0].upper() for w in x.split())\n", 'text'),
+    ('rotate_k', 'rotate list left by K', "def f(x):\n    k = {K} % len(x) if x else 0\n    return x[k:] + x[:k]\n", 'ints'),
+    ('count_k', 'count values greater than K', "def f(x):\n    return sum(1 for v in x if v > {K})\n", 'ints'),
+)
+
+
+def program_input(kind, rng):
+    if kind == 'text':
+        return ' '.join(rng.choice(WORDS + NAMES) for _ in range(rng.randint(1, 5)))
+    return [rng.randint(-9, 20) for _ in range(rng.randint(0, 7))]
+
+
+def induction_task(seed, families=None):
+    rng = random.Random(seed)
+    family, description, template, kind = rng.choice([p for p in PROGRAMS if families is None or p[0] in families])
+    k = rng.randint(2, 6)
+    source = template.replace('{K}', str(k))
+    namespace = {}
+    exec(compile(source, 'oracle_program', 'exec'), namespace)  # Jarvis-authored template, not model output
+    function = namespace['f']
+    inputs, seen = [], set()
+    while len(inputs) < 10:
+        value = program_input(kind, rng)
+        key = json.dumps(value)
+        if key not in seen:
+            seen.add(key)
+            inputs.append(value)
+    cases = [{'input': v, 'output': function(copy.deepcopy(v))} for v in inputs]
+    if [function(copy.deepcopy(c['input'])) for c in cases] != [c['output'] for c in cases]:
+        raise ValueError('Oracle program is nondeterministic')  # AZR determinism check (run twice)
+    return {'mode': 'induction', 'seed': seed, 'family': family, 'k': k,
+            'message': 'Write f(x) to ' + description + ('' if '{K}' not in template else ' (K is a constant to infer)') + '.',
+            'visible': cases[:4], 'hidden': cases[4:], 'reference_source': source}
+
+
+# ---- the independent oracle ----------------------------------------------------------------------------------------------
+def parse_json_answer(text):
+    """Extract one JSON object from model output; a format failure is distinguished from a wrong answer."""
+    if isinstance(text, (dict, list)):
+        return text
+    text = str(text)
+    decoder = json.JSONDecoder(strict=False)  # models often emit raw newlines inside strings
+    for match in re.finditer(r'[\[{]', text):  # first decodable JSON value, ignoring prose or code around it
+        try:
+            value, _ = decoder.raw_decode(text, match.start())
+        except ValueError:
+            continue
+        if isinstance(value, (dict, list)):
+            return value
+    raise ValueError('no JSON object')
+
+
+def check_deduction(task, answer):
+    try:
+        value = parse_json_answer(answer)
+    except ValueError:
+        return {'format_ok': False, 'correct': False, 'reason': 'unparseable'}
+    if not isinstance(value, dict) or not {'files', 'apps', 'clipboard', 'halted'} <= set(value):
+        return {'format_ok': False, 'correct': False, 'reason': 'schema'}
+    expected = task['answer']
+    try:
+        predicted = {**canonical(value), 'halted': value['halted']}
+    except (TypeError, KeyError, AttributeError):
+        return {'format_ok': False, 'correct': False, 'reason': 'schema'}
+    return {'format_ok': True, 'correct': predicted == expected, 'reason': 'match' if predicted == expected else 'mismatch'}
+
+
+def topological_orders(plan, limit=24):
+    by_id = {c['id']: c for c in plan}
+    deps = {c['id']: set(c['deps']) for c in plan}
+    orders = []
+    def walk(done, order):
+        if len(orders) >= limit:
+            return
+        if len(order) == len(plan):
+            orders.append(list(order))
+            return
+        for identifier in sorted(by_id):
+            if identifier not in done and deps[identifier] <= done:
+                walk(done | {identifier}, order + [by_id[identifier]])
+    walk(set(), [])
+    return orders
+
+
+def check_abduction(task, answer):
+    """Outcome-judged: valid schema and DAG, every pair of conflicting calls ordered, all orders reach the goal."""
+    try:
+        plan = parse_json_answer(answer)
+    except ValueError:
+        return {'format_ok': False, 'correct': False, 'reason': 'unparseable'}
+    if isinstance(plan, dict):
+        plan = plan.get('plan', plan.get('calls'))
+    if not isinstance(plan, list) or not 1 <= len(plan) <= MAX_CALLS:
+        return {'format_ok': False, 'correct': False, 'reason': 'schema'}
+    ids = set()
+    for call in plan:
+        if (not isinstance(call, dict) or set(call) != {'id', 'tool', 'args', 'deps'} or not isinstance(call['id'], str)
+                or call['id'] in ids or call['tool'] not in TOOLS or not isinstance(call['args'], dict)
+                or set(call['args']) != set(TOOLS[call['tool']][0]) or not all(isinstance(v, str) for v in call['args'].values())
+                or not isinstance(call['deps'], list) or not all(isinstance(d, str) for d in call['deps'])):
+            return {'format_ok': False, 'correct': False, 'reason': 'schema'}
+        ids.add(call['id'])
+    if any(d not in ids or d == c['id'] for c in plan for d in c['deps']):
+        return {'format_ok': True, 'correct': False, 'reason': 'unknown_dependency'}
+    orders = topological_orders(plan)
+    if not orders:
+        return {'format_ok': True, 'correct': False, 'reason': 'cycle'}
+    ancestors = {}
+    def above(identifier):
+        if identifier not in ancestors:
+            ancestors[identifier] = set()
+            for dep in next(c for c in plan if c['id'] == identifier)['deps']:
+                ancestors[identifier] |= {dep} | above(dep)
+        return ancestors[identifier]
+    for first, second in itertools.combinations(plan, 2):
+        r1, w1 = resources(first)
+        r2, w2 = resources(second)
+        if (w1 & (r2 | w2)) or (w2 & r1):
+            if first['id'] not in above(second['id']) and second['id'] not in above(first['id']):
+                return {'format_ok': True, 'correct': False, 'reason': 'missing_dependency:' + first['id'] + '/' + second['id']}
+    for order in orders:
+        result = execute(task['initial'], order)
+        if result['halted'] or {k: result[k] for k in ('files', 'apps', 'clipboard')} != task['desired']:
+            return {'format_ok': True, 'correct': False, 'reason': 'goal_not_reached' if not result['halted'] else 'halted'}
+    return {'format_ok': True, 'correct': True, 'reason': 'goal_reached_in_all_orders', 'orders_checked': len(orders)}
+
+
+SAFE_BUILTINS = {'len', 'range', 'sum', 'min', 'max', 'sorted', 'reversed', 'enumerate', 'zip', 'map', 'filter', 'abs',
+                 'list', 'tuple', 'set', 'dict', 'str', 'int', 'float', 'bool', 'any', 'all', 'round', 'divmod'}
+FORBIDDEN = {'eval', 'exec', 'compile', 'open', '__import__', 'globals', 'locals', 'vars', 'getattr', 'setattr', 'delattr',
+             'input', 'breakpoint', 'help', 'memoryview', 'type', 'object', 'super', 'classmethod', 'staticmethod', 'property'}
+
+
+def extract_code(text):
+    match = re.search(r'```(?:python)?\s*\n(.*?)```', str(text), re.S)
+    return (match.group(1) if match else str(text)).strip() + '\n'
+
+
+def screen_program(source):
+    """Static safety screen. Passing it is necessary, not sufficient: execution still happens only in the container."""
+    if not 10 <= len(source) <= 3000:
+        raise ValueError('program size')
+    tree = ast.parse(source)
+    if len(tree.body) != 1 or not isinstance(tree.body[0], ast.FunctionDef) or tree.body[0].name != 'f':
+        raise ValueError('exactly one top-level function f is required')
+    for node in ast.walk(tree):
+        if isinstance(node, (ast.Import, ast.ImportFrom, ast.Global, ast.Nonlocal, ast.ClassDef, ast.AsyncFunctionDef,
+                             ast.Await, ast.With, ast.Try, ast.Raise, ast.Lambda, ast.Yield, ast.YieldFrom, ast.Delete)):
+            raise ValueError('disallowed construct: ' + type(node).__name__)
+        if isinstance(node, ast.Name) and (node.id in FORBIDDEN or node.id.startswith('__')):
+            raise ValueError('forbidden name: ' + node.id)
+        if isinstance(node, ast.Attribute) and node.attr.startswith('_'):
+            raise ValueError('private attribute')
+        if isinstance(node, ast.While):
+            raise ValueError('while loops are not allowed (termination)')
+    return hashlib.sha256(source.encode()).hexdigest()
+
+
+def task_id(task):
+    body = {k: task[k] for k in task if k not in {'answer', 'reference_plan', 'reference_source', 'hidden', 'seed'}}
+    return task['mode'][:3] + '_' + hashlib.sha256(json.dumps(body, sort_keys=True).encode()).hexdigest()[:16]
+
+
+def signature(task):
+    """Near-duplicate signature: tool/structure skeleton without concrete strings."""
+    if task['mode'] == 'deduction':
+        return 'ded:' + '-'.join(c['tool'] for c in task['calls']) + ':' + str(len(task['initial']['files']))
+    if task['mode'] == 'abduction':
+        return 'abd:' + '-'.join(sorted(c['tool'] for c in task['reference_plan'])) + ':' + str(len(task['desired']['files']))
+    return 'ind:' + task['family'] + ':' + str(task.get('k'))
+
+
+# ---- prompts and verified targets ---------------------------------------------------------------------------------------
+SYSTEM = ('You are Jarvis reasoning about a simulated computer. The state has files (path -> text), open apps and a '
+          'clipboard. Tools: create_file(path, content) fails if the path exists; append_file(path, text); '
+          'replace_text(path, old, new) replaces the first occurrence and fails if old is absent; copy_file(src, dst) and '
+          'move_file(src, dst) fail if src is missing or dst exists; delete_file(path); open_app(app) fails if open; '
+          'close_app(app) fails if not open; copy_text(path) copies file text to the clipboard; paste_append(path) appends '
+          'the clipboard. Execution stops at the first failing call. Reply with JSON or code only.')
+
+
+def render_prompt(task):
+    if task['mode'] == 'deduction':
+        return ('DEDUCTION. Initial state: ' + json.dumps(task['initial'], sort_keys=True) + '\nCalls in order: ' +
+                json.dumps(task['calls']) + '\nReturn the final state as JSON with keys files, apps (sorted), clipboard '
+                'and halted (null, or {"step": id, "reason": code} for the first failing call).')
+    if task['mode'] == 'abduction':
+        return ('ABDUCTION. Initial state: ' + json.dumps(task['initial'], sort_keys=True) + '\nDesired state: ' +
+                json.dumps(task['desired'], sort_keys=True) + '\nReturn a JSON list of calls {"id", "tool", "args", "deps"} '
+                'whose every dependency-respecting order reaches the desired state; calls touching the same file, app '
+                'or clipboard must be ordered through deps.')
+    return ('INDUCTION. ' + task['message'] + '\nExamples (input -> output): ' +
+            json.dumps([[c['input'], c['output']] for c in task['visible']]) +
+            '\nReturn only a Python function named f(x) without imports.')
+
+
+def render_target(task):
+    """Training target taken only from the oracle (environment result, verified plan, verified program)."""
+    if task['mode'] == 'deduction':
+        return json.dumps(task['answer'], sort_keys=True)
+    if task['mode'] == 'abduction':
+        return json.dumps([{k: c[k] for k in ('id', 'tool', 'args', 'deps')} for c in task['reference_plan']])
+    return task['reference_source'].strip()
