+"""Registry of locally trained checkpoints; every entry starts and stays *experimental* until approved.
+
+Approval requires a ``qualified_experimental`` decision from the sealed model gate, a passing export
+compatibility check (merged model reproduces the adapter's greedy outputs), unchanged adapter bytes,
+and an explicit approval card. Even then the registry only records the approval: it never edits
+``config.json``, never replaces a configured endpoint and never registers a model with Ollama.
+"""
+from datetime import datetime, timezone
+import hashlib
+import json
+from pathlib import Path
+import uuid
+
+
+def _sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+class ModelRegistry:
+    def __init__(self, base):
+        self.path = Path(base) / '.jarvis-runtime' / 'models' / 'registry.json'
+
+    def entries(self):
+        try:
+            return json.loads(self.path.read_text(encoding='utf-8'))
+        except (OSError, ValueError):
+            return []
+
+    def _save(self, rows):
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        temporary = self.path.with_suffix('.tmp')
+        temporary.write_text(json.dumps(rows, indent=1), encoding='utf-8')
+        temporary.replace(self.path)
+
+    def register(self, adapter, base_sha256, dataset_sha256, gate_report, export_check=None):
+        adapter = Path(adapter)
+        row = {'id': 'model_' + uuid.uuid4().hex[:10], 'adapter': str(adapter),
+               'adapter_sha256': _sha(adapter / 'adapter_model.safetensors'), 'base_sha256': base_sha256,
+               'dataset_manifest_sha256': dataset_sha256, 'gate_decision': gate_report.get('decision'),
+               'gate_seal': gate_report.get('seal'), 'export_check': export_check, 'status': 'experimental',
+               'registered_at': datetime.now(timezone.utc).isoformat(timespec='seconds')}
+        rows = self.entries()
+        rows.append(row)
+        self._save(rows)
+        return row
+
+    def approve(self, identifier, approve, cancelled=lambda: False):
+        rows = self.entries()
+        row = next((r for r in rows if r['id'] == identifier), None)
+        if row is None:
+            raise ValueError('Unknown model entry.')
+        if row['gate_decision'] != 'qualified_experimental':
+            raise ValueError('Only a checkpoint that qualified on the sealed held-out gate can be approved.')
+        export = row.get('export_check') or {}
+        if export.get('exact_match_rate', 0) < 0.95 or not export.get('merged_reloads_with_transformers'):
+            raise ValueError('Export compatibility has not been demonstrated.')
+        if _sha(Path(row['adapter']) / 'adapter_model.safetensors') != row['adapter_sha256']:
+            raise ValueError('Adapter bytes changed since evaluation.')
+        approve('model_promotion', 'Mark trained checkpoint ' + identifier + ' as approved for future use? '
+                'No configuration, endpoint or Ollama model is changed by this approval.', cancelled)
+        row['status'] = 'approved'
+        row['approved_at'] = datetime.now(timezone.utc).isoformat(timespec='seconds')
+        self._save(rows)
+        return row
diff --git a/app/scripts/training/azr_generate.py b/app/scripts/training/azr_generate.py
new file mode 100644
index 0000000..2822551
--- /dev/null
+++ b/app/scripts/training/azr_generate.py
@@ -0,0 +1,94 @@
+"""Batched greedy generation for AZR tasks with the base model or base + LoRA adapter (.venv-training).
+
+Writes answers only; scoring happens separately in the main environment through the independent
+oracle (``jarvis.azr_reward``), so the generation process cannot influence its own rewards.
+Records per-task latency, generated tokens and peak VRAM.
+Usage: python -m scripts.training.azr_generate --tasks <jsonl> --out <jsonl> [--adapter <dir>]
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+import time
+
+BASE = Path(__file__).resolve().parents[2]
+if str(BASE) not in sys.path:
+    sys.path.insert(0, str(BASE))
+
+from scripts.training.train_qwen_weights import BASE_SHA256  # noqa: E402
+
+MAX_NEW = {'deduction': 320, 'abduction': 384, 'induction': 192}
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--tasks', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True)
+    parser.add_argument('--adapter', type=Path)
+    parser.add_argument('--merged', type=Path, help='a merged full model directory (export compatibility check)')
+    parser.add_argument('--batch', type=int, default=8)
+    parser.add_argument('--limit', type=int, default=0)
+    args = parser.parse_args(argv)
+    if args.out.exists():
+        parser.error('refusing to overwrite ' + str(args.out))
+    os.environ.update(HF_HUB_OFFLINE='1', TRANSFORMERS_OFFLINE='1', HF_HOME=str(BASE / 'models/hf-training-cache'),
+                      USE_TF='0', USE_FLAX='0', TOKENIZERS_PARALLELISM='false')
+    import torch
+    from transformers import AutoModelForCausalLM, AutoTokenizer
+    from jarvis.azr_tasks import SYSTEM, render_prompt
+    base_dir = BASE / 'models/qwen-jarvis-base'
+    digest = hashlib.sha256()
+    with (base_dir / 'model.safetensors').open('rb') as stream:
+        while block := stream.read(1 << 20):
+            digest.update(block)
+    if digest.hexdigest() != BASE_SHA256:
+        raise SystemExit('Base model checksum mismatch.')
+    tokenizer = AutoTokenizer.from_pretrained(base_dir, local_files_only=True, padding_side='left')
+    source = args.merged or base_dir
+    model = AutoModelForCausalLM.from_pretrained(source, torch_dtype=torch.bfloat16, attn_implementation='sdpa',
+                                                 local_files_only=True).to('cuda')
+    if args.adapter:
+        from peft import PeftModel
+        model = PeftModel.from_pretrained(model, args.adapter, local_files_only=True)
+    model.eval()
+    rows = [json.loads(line) for line in args.tasks.read_text(encoding='utf-8').splitlines() if line.strip()]
+    if args.limit:
+        rows = rows[:args.limit]
+    torch.cuda.reset_peak_memory_stats()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    started_all = time.monotonic()
+    with args.out.open('w', encoding='utf-8') as handle:
+        for mode in ('deduction', 'abduction', 'induction'):
+            subset = [r for r in rows if r['task']['mode'] == mode]
+            for start in range(0, len(subset), args.batch):
+                batch = subset[start:start + args.batch]
+                texts = [tokenizer.apply_chat_template([{'role': 'system', 'content': SYSTEM},
+                                                        {'role': 'user', 'content': render_prompt(r['task'])}],
+                                                       tokenize=False, add_generation_prompt=True) for r in batch]
+                encoded = tokenizer(texts, return_tensors='pt', padding=True, add_special_tokens=False).to('cuda')
+                began = time.monotonic()
+                with torch.no_grad():
+                    output = model.generate(**encoded, do_sample=False, max_new_tokens=MAX_NEW[mode],
+                                            pad_token_id=tokenizer.eos_token_id)
+                seconds = time.monotonic() - began
+                for index, row in enumerate(batch):
+                    generated = output[index, encoded['input_ids'].shape[1]:]
+                    text = tokenizer.decode(generated, skip_special_tokens=True)
+                    tokens = int((generated != tokenizer.eos_token_id).sum())
+                    handle.write(json.dumps({'id': row['id'], 'mode': mode, 'answer': text, 'new_tokens': tokens,
+                                             'batch_seconds': round(seconds, 3), 'batch_size': len(batch)}) + '\n')
+                handle.flush()
+                print(json.dumps({'mode': mode, 'done': start + len(batch), 'of': len(subset), 'seconds': round(seconds, 2)}),
+                      flush=True)
+    summary = {'model': 'base' if not (args.adapter or args.merged) else str(args.adapter or args.merged),
+               'tasks': len(rows), 'seconds': round(time.monotonic() - started_all, 1),
+               'peak_vram_mb': round(torch.cuda.max_memory_allocated() / 2 ** 20), 'batch': args.batch,
+               'decoding': 'greedy', 'max_new_tokens': MAX_NEW}
+    args.out.with_suffix('.summary.json').write_text(json.dumps(summary, indent=1), encoding='utf-8')
+    print(json.dumps(summary))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/app/scripts/training/build_azr_dataset.py b/app/scripts/training/build_azr_dataset.py
new file mode 100644
index 0000000..ae37dc7
--- /dev/null
+++ b/app/scripts/training/build_azr_dataset.py
@@ -0,0 +1,98 @@
+"""Build the versioned AZR dataset: seeded tasks + optional local-proposer tasks, all oracle-verified.
+
+* Held-out tasks are written into the sealed evaluator (``evolution_eval/heldout/azr_tasks.jsonl``);
+  train and validation go to ``--out`` (refuses to overwrite).
+* Answerability: every induction reference program is executed twice in the sandbox on its visible and
+  hidden cases; any task whose reference fails is dropped (and counted).
+* Proposer tasks (local ``qwen3.5:9b``) are validated by the oracle, scored for learnability with G local
+  solver rollouts, de-duplicated, checked against held-out signatures, and added to train only.
+"""
+import argparse
+import json
+from pathlib import Path
+import sys
+import time
+
+BASE = Path(__file__).resolve().parents[2]
+if str(BASE) not in sys.path:
+    sys.path.insert(0, str(BASE))
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--out', type=Path, required=True)
+    parser.add_argument('--heldout-out', type=Path, default=BASE / 'evolution_eval' / 'heldout' / 'azr_tasks.jsonl')
+    parser.add_argument('--train', type=int, nargs=3, default=[400, 400, 300], metavar=('DED', 'ABD', 'IND'))
+    parser.add_argument('--validation', type=int, nargs=3, default=[30, 30, 30])
+    parser.add_argument('--heldout', type=int, nargs=3, default=[60, 60, 60])
+    parser.add_argument('--proposals', type=int, default=0, help='local proposer attempts per mode (0 disables)')
+    args = parser.parse_args(argv)
+    if args.heldout_out.exists():
+        raise SystemExit('Refusing to overwrite sealed held-out data: ' + str(args.heldout_out))
+    from jarvis import azr_dataset
+    from jarvis.azr_sandbox import run_programs
+    from jarvis.azr_tasks import signature, task_id
+    counts = {split: dict(zip(('deduction', 'abduction', 'induction'), values))
+              for split, values in (('train', args.train), ('validation', args.validation), ('heldout', args.heldout))}
+    datasets, meta = azr_dataset.build(counts)
+    dropped = {}
+    for split, rows in datasets.items():
+        induction = [r for r in rows if r['task']['mode'] == 'induction']
+        programs = [{'id': r['id'], 'source': r['task']['reference_source'], 'cases': r['task']['visible'] + r['task']['hidden']}
+                    for r in induction]
+        verified = {}
+        for start in range(0, len(programs), 60):
+            verified.update(run_programs(BASE, programs[start:start + 60]))
+        bad = {r['id'] for r in induction if not verified[r['id']]['passed']}
+        dropped[split] = len(bad)
+        datasets[split] = [r for r in rows if r['id'] not in bad]
+        for row in datasets[split]:
+            if row['task']['mode'] == 'induction':
+                row['provenance']['sandbox_verified'] = True
+    meta['answerability_dropped'] = dropped
+    proposer_report = None
+    if args.proposals:
+        from jarvis.azr_proposer import Proposer, abduction_from
+        proposer = Proposer(BASE, seed=7)
+        reserved = {r['signature'] for split in ('heldout', 'validation') for r in datasets[split]}
+        known = {r['id'] for split in datasets for r in datasets[split]}
+        accepted, scored = [], []
+        references = [datasets['train'][0]['task']]
+        started = time.monotonic()
+        for attempt in range(args.proposals):
+            for mode in ('deduction', 'induction'):
+                task = proposer.propose_deduction(references) if mode == 'deduction' else \
+                    proposer.propose_induction(references, run_programs)
+                if task is None:
+                    continue
+                tasks = [task] + ([abduction_from(task)] if mode == 'deduction' else [])
+                for item in filter(None, tasks):
+                    item.setdefault('seed', None)
+                    identifier, skeleton = task_id(item), signature(item)
+                    if identifier in known or skeleton in reserved:
+                        proposer.rejections.append({'mode': item['mode'], 'reason': 'duplicate or held-out signature'})
+                        continue
+                    learn = proposer.learnability(item) if item['mode'] != 'induction' else {'solve_rate': None,
+                                                                                            'r_propose': None}
+                    scored.append({'mode': item['mode'], **learn})
+                    known.add(identifier)
+                    accepted.append({'schema_version': azr_dataset.SCHEMA_VERSION, 'id': identifier, 'split': 'train',
+                                     'signature': skeleton, 'task': {k: v for k, v in item.items() if k != 'provenance'},
+                                     'provenance': {**item.get('provenance', {}), 'learnability': learn,
+                                                    'env_version': 1, 'oracle_version': 1}})
+        datasets['train'].extend(accepted)
+        proposer_report = {'attempts_per_mode': args.proposals, 'accepted': len(accepted), 'rejected': proposer.rejections,
+                           'learnability': scored, 'minutes': round((time.monotonic() - started) / 60, 1),
+                           'proposer': proposer.proposer, 'solver': proposer.solver, 'rollouts': proposer.rollouts}
+        meta['proposer'] = proposer_report
+    heldout = datasets.pop('heldout')
+    manifest = azr_dataset.write(args.out, datasets, meta)
+    args.heldout_out.parent.mkdir(parents=True, exist_ok=True)
+    args.heldout_out.write_text(''.join(json.dumps(r, sort_keys=True) + '\n' for r in heldout), encoding='utf-8')
+    summary = {'manifest': manifest['counts'], 'heldout': len(heldout), 'leakage': meta['leakage'],
+               'answerability_dropped': dropped, 'proposer_accepted': proposer_report and proposer_report['accepted']}
+    print(json.dumps(summary, indent=1))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/app/scripts/training/export_azr_adapter.py b/app/scripts/training/export_azr_adapter.py
new file mode 100644
index 0000000..fc9ecbe
--- /dev/null
+++ b/app/scripts/training/export_azr_adapter.py
@@ -0,0 +1,81 @@
+"""Export-compatibility check for an AZR LoRA adapter (.venv-training). Registers nothing.
+
+1. Merge the adapter into the checksum-pinned base (PEFT ``merge_and_unload``) and save the merged
+   model with its tokenizer.
+2. Reload the merged model with plain transformers and compare greedy outputs with the unmerged
+   adapter on held-out prompts (exact text match rate).
+3. Report whether a GGUF converter is available for Ollama registration; if not, that step is BLOCKED.
+"""
+import argparse
+import importlib.util
+import json
+import os
+from pathlib import Path
+import shutil
+import sys
+
+BASE = Path(__file__).resolve().parents[2]
+if str(BASE) not in sys.path:
+    sys.path.insert(0, str(BASE))
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--adapter', type=Path, required=True)
+    parser.add_argument('--tasks', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True)
+    parser.add_argument('--limit', type=int, default=24)
+    args = parser.parse_args(argv)
+    if args.out.exists():
+        parser.error('refusing to overwrite ' + str(args.out))
+    os.environ.update(HF_HUB_OFFLINE='1', TRANSFORMERS_OFFLINE='1', HF_HOME=str(BASE / 'models/hf-training-cache'),
+                      USE_TF='0', USE_FLAX='0')
+    import torch
+    from peft import PeftModel
+    from transformers import AutoModelForCausalLM, AutoTokenizer
+    from jarvis.azr_tasks import SYSTEM, render_prompt
+    base_dir = BASE / 'models/qwen-jarvis-base'
+    tokenizer = AutoTokenizer.from_pretrained(base_dir, local_files_only=True, padding_side='left')
+    rows = [json.loads(line) for line in args.tasks.read_text(encoding='utf-8').splitlines() if line.strip()]
+    rows = [r for mode in ('deduction', 'abduction', 'induction') for r in rows if r['task']['mode'] == mode][::max(1, len(rows) // args.limit)][:args.limit]
+
+    def outputs(model):
+        texts = []
+        for row in rows:
+            prompt = tokenizer.apply_chat_template([{'role': 'system', 'content': SYSTEM},
+                                                    {'role': 'user', 'content': render_prompt(row['task'])}],
+                                                   tokenize=False, add_generation_prompt=True)
+            encoded = tokenizer(prompt, return_tensors='pt', add_special_tokens=False).to('cuda')
+            with torch.no_grad():
+                generated = model.generate(**encoded, do_sample=False, max_new_tokens=256, pad_token_id=tokenizer.eos_token_id)
+            texts.append(tokenizer.decode(generated[0, encoded['input_ids'].shape[1]:], skip_special_tokens=True))
+        return texts
+
+    base = AutoModelForCausalLM.from_pretrained(base_dir, torch_dtype=torch.bfloat16, local_files_only=True).to('cuda')
+    adapted = PeftModel.from_pretrained(base, args.adapter, local_files_only=True)
+    adapted.eval()
+    adapter_texts = outputs(adapted)
+    merged = adapted.merge_and_unload(safe_merge=True)
+    merged_dir = args.out / 'merged'
+    merged.save_pretrained(merged_dir, safe_serialization=True)
+    tokenizer.save_pretrained(merged_dir)
+    del merged, adapted, base
+    torch.cuda.empty_cache()
+    reloaded = AutoModelForCausalLM.from_pretrained(merged_dir, torch_dtype=torch.bfloat16, local_files_only=True).to('cuda')
+    reloaded.eval()
+    merged_texts = outputs(reloaded)
+    matches = sum(a == b for a, b in zip(adapter_texts, merged_texts))
+    gguf = importlib.util.find_spec('gguf') is not None or shutil.which('llama-quantize') is not None
+    report = {'adapter': str(args.adapter), 'prompts': len(rows), 'exact_match': matches,
+              'exact_match_rate': round(matches / len(rows), 4), 'merged_dir': str(merged_dir),
+              'merged_reloads_with_transformers': True,
+              'gguf_conversion': 'available' if gguf else 'BLOCKED: no GGUF converter (gguf package / llama.cpp) installed',
+              'ollama_registration': 'not performed (requires approval and a GGUF export)',
+              'mismatches': [{'id': r['id'], 'adapter': a[:200], 'merged': b[:200]}
+                             for r, a, b in zip(rows, adapter_texts, merged_texts) if a != b][:5]}
+    (args.out / 'export-check.json').write_text(json.dumps(report, indent=1), encoding='utf-8')
+    print(json.dumps({k: v for k, v in report.items() if k != 'mismatches'}, indent=1))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/app/scripts/training/grpo_feasibility.py b/app/scripts/training/grpo_feasibility.py
new file mode 100644
index 0000000..b9c48a9
--- /dev/null
+++ b/app/scripts/training/grpo_feasibility.py
@@ -0,0 +1,106 @@
+"""RLVR/GRPO feasibility probe on the 4 GB GPU (.venv-training). Measures; does not claim training.
+
+For a few train tasks: sample G answers from the SFT adapter (temperature 0.8), score each with the
+independent oracle (deduction/abduction only; no code execution in this process), compute
+group-normalized advantages (GRPO, per task), and take policy-gradient steps on the LoRA weights:
+loss = -mean(advantage * mean token log-prob of the sampled answer). Reports peak VRAM, seconds per
+step, reward statistics and whether any group had non-zero reward variance (a learning signal).
+Writes no adapter unless --save is given.
+"""
+import argparse
+import json
+import os
+from pathlib import Path
+import statistics
+import sys
+import time
+
+BASE = Path(__file__).resolve().parents[2]
+if str(BASE) not in sys.path:
+    sys.path.insert(0, str(BASE))
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--adapter', type=Path, required=True)
+    parser.add_argument('--dataset', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True)
+    parser.add_argument('--tasks', type=int, default=4)
+    parser.add_argument('--group', type=int, default=4)
+    parser.add_argument('--max-new', type=int, default=256)
+    args = parser.parse_args(argv)
+    if args.out.exists():
+        parser.error('refusing to overwrite ' + str(args.out))
+    os.environ.update(HF_HUB_OFFLINE='1', TRANSFORMERS_OFFLINE='1', HF_HOME=str(BASE / 'models/hf-training-cache'),
+                      USE_TF='0', USE_FLAX='0')
+    import torch
+    from peft import PeftModel
+    from transformers import AutoModelForCausalLM, AutoTokenizer
+    from jarvis.azr_dataset import load
+    from jarvis.azr_reward import score_symbolic
+    from jarvis.azr_tasks import SYSTEM, render_prompt
+    base_dir = BASE / 'models/qwen-jarvis-base'
+    tokenizer = AutoTokenizer.from_pretrained(base_dir, local_files_only=True)
+    model = AutoModelForCausalLM.from_pretrained(base_dir, torch_dtype=torch.bfloat16, local_files_only=True).to('cuda')
+    model = PeftModel.from_pretrained(model, args.adapter, is_trainable=True, local_files_only=True)
+    model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={'use_reentrant': False})
+    model.enable_input_require_grads()
+    params = [p for p in model.parameters() if p.requires_grad]
+    optimizer = torch.optim.AdamW(params, lr=1e-5)
+    rows = [r for r in load(args.dataset, 'validation') if r['task']['mode'] in {'deduction', 'abduction'}][:args.tasks]
+    torch.manual_seed(7)
+    torch.cuda.reset_peak_memory_stats()
+    steps = []
+    for row in rows:
+        started = time.monotonic()
+        prompt = tokenizer.apply_chat_template([{'role': 'system', 'content': SYSTEM},
+                                                {'role': 'user', 'content': render_prompt(row['task'])}],
+                                               tokenize=False, add_generation_prompt=True)
+        encoded = tokenizer(prompt, return_tensors='pt', add_special_tokens=False).to('cuda')
+        model.eval()
+        model.config.use_cache = True
+        with torch.no_grad():
+            samples = model.generate(**encoded, do_sample=True, temperature=0.8, top_p=0.95, max_new_tokens=args.max_new,
+                                     num_return_sequences=args.group, pad_token_id=tokenizer.eos_token_id)
+        sampled_seconds = time.monotonic() - started
+        prefix = encoded['input_ids'].shape[1]
+        texts = [tokenizer.decode(s[prefix:], skip_special_tokens=True) for s in samples]
+        rewards = [score_symbolic(row['task'], text)['reward'] for text in texts]
+        mean, spread = statistics.fmean(rewards), statistics.pstdev(rewards)
+        advantages = [(r - mean) / (spread + 1e-6) for r in rewards]
+        model.train()
+        model.config.use_cache = False
+        optimizer.zero_grad(set_to_none=True)
+        losses = []
+        for sample, advantage in zip(samples, advantages):
+            if advantage == 0:
+                continue
+            ids = sample.unsqueeze(0)
+            mask = (ids != tokenizer.pad_token_id).long() if tokenizer.pad_token_id is not None else torch.ones_like(ids)
+            with torch.autocast('cuda', dtype=torch.bfloat16):
+                logits = model(input_ids=ids, attention_mask=mask).logits[:, :-1].float()
+            targets = ids[:, 1:]
+            logprobs = torch.log_softmax(logits, -1).gather(-1, targets.unsqueeze(-1)).squeeze(-1)[:, prefix - 1:]
+            answer_mask = (targets[:, prefix - 1:] != tokenizer.eos_token_id).float()
+            loss = -advantage * (logprobs * answer_mask).sum() / answer_mask.sum().clamp(min=1) / args.group
+            loss.backward()
+            losses.append(float(loss.detach()))
+        if losses:
+            torch.nn.utils.clip_grad_norm_(params, 1.0)
+            optimizer.step()
+        steps.append({'task': row['id'], 'mode': row['task']['mode'], 'rewards': rewards, 'reward_std': round(spread, 4),
+                      'updated': bool(losses), 'sample_seconds': round(sampled_seconds, 2),
+                      'step_seconds': round(time.monotonic() - started, 2)})
+        print(json.dumps(steps[-1]), flush=True)
+    args.out.mkdir(parents=True)
+    report = {'group_size': args.group, 'tasks': len(steps), 'steps': steps,
+              'peak_vram_mb': round(torch.cuda.max_memory_allocated() / 2 ** 20),
+              'groups_with_signal': sum(s['reward_std'] > 0 for s in steps),
+              'mean_step_seconds': round(statistics.fmean(s['step_seconds'] for s in steps), 2) if steps else None,
+              'note': 'Feasibility probe only: a handful of GRPO-style updates; no claim of improvement.'}
+    (args.out / 'grpo-feasibility.json').write_text(json.dumps(report, indent=1), encoding='utf-8')
+    print(json.dumps({k: v for k, v in report.items() if k != 'steps'}, indent=1))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/app/scripts/training/train_azr_lora.py b/app/scripts/training/train_azr_lora.py
new file mode 100644
index 0000000..f334325
--- /dev/null
+++ b/app/scripts/training/train_azr_lora.py
@@ -0,0 +1,252 @@
+"""Resource-aware LoRA SFT on independently verified AZR tasks (Pillar D, Phase 7).
+
+Trains a LoRA adapter on the original Qwen2.5-Coder-0.5B-Instruct weights (``models/qwen-jarvis-base``,
+checksum-pinned; never an Ollama quantized file). Every target comes from the deterministic oracle
+(``jarvis.azr_tasks.render_target``), never from a model.
+
+Budgets and safety:
+* bounded steps, batch 1 with gradient accumulation, gradient checkpointing, max sequence length;
+* explicit VRAM and process-RAM ceilings: exceeding either checkpoints and stops (``resource_limit``);
+* foreground preemption: before every optimizer step the shared GPU lease registry is read; any active
+  or pending Jarvis inference stops training after a checkpoint (``preempted``); training never runs
+  while Jarvis needs the GPU and never preempts Jarvis;
+* cancellation: creating ``<out>/STOP`` (or Ctrl+C) checkpoints and stops (``cancelled``);
+* resume: ``--resume <out>`` restores adapter, optimizer, scheduler, RNG states and data position, after
+  checking dataset, base model and configuration hashes;
+* no network: Hugging Face offline mode; nothing is uploaded.
+"""
+import argparse
+from datetime import datetime, timezone
+import hashlib
+import json
+import os
+from pathlib import Path
+import random
+import shutil
+import sys
+import time
+
+BASE = Path(__file__).resolve().parents[2]
+if str(BASE) not in sys.path:
+    sys.path.insert(0, str(BASE))
+
+from scripts.training.train_qwen_weights import BASE_SHA256, MODEL, REVISION  # noqa: E402
+
+STATE_VERSION = 1
+
+
+def sha256_file(path):
+    digest = hashlib.sha256()
+    with Path(path).open('rb') as stream:
+        while block := stream.read(1 << 20):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def foreground_gpu_busy():
+    """True when any Jarvis inference holds or waits for the GPU (read-only look at the lease registry)."""
+    state_path = BASE / '.jarvis-runtime' / 'gpu' / 'state.json'
+    try:
+        state = json.loads(state_path.read_text(encoding='utf-8'))
+    except (OSError, ValueError):
+        return False
+    from jarvis.gpu_scheduler import alive
+    rows = ([state['active']] if state.get('active') else []) + list(state.get('pending', []))
+    return any(alive(row) for row in rows)
+
+
+def load_examples(dataset, split):
+    from jarvis.azr_dataset import load
+    from jarvis.azr_tasks import render_prompt, render_target
+    rows = load(dataset, split)
+    return [{'id': r['id'], 'mode': r['task']['mode'], 'prompt': render_prompt(r['task']), 'target': render_target(r['task'])}
+            for r in rows]
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--dataset', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True)
+    parser.add_argument('--max-steps', type=int, default=60)
+    parser.add_argument('--grad-accum', type=int, default=8)
+    parser.add_argument('--lr', type=float, default=2e-4)
+    parser.add_argument('--max-len', type=int, default=896)
+    parser.add_argument('--lora-r', type=int, default=8)
+    parser.add_argument('--checkpoint-every', type=int, default=10)
+    parser.add_argument('--vram-limit-mb', type=int, default=3300)
+    parser.add_argument('--ram-limit-mb', type=int, default=6144)
+    parser.add_argument('--max-minutes', type=float, default=45)
+    parser.add_argument('--seed', type=int, default=20261019)
+    parser.add_argument('--resume', action='store_true')
+    parser.add_argument('--ignore-foreground', action='store_true', help='tests only: skip the GPU lease check')
+    args = parser.parse_args(argv)
+    if not 1 <= args.max_steps <= 2000 or not 1 <= args.grad_accum <= 64 or not 128 <= args.max_len <= 2048:
+        parser.error('bounded budgets: 1-2000 steps, 1-64 accumulation, 128-2048 tokens')
+    out = args.out.resolve()
+    if args.resume:
+        if not (out / 'run.json').is_file():
+            parser.error('nothing to resume in ' + str(out))
+    elif out.exists():
+        parser.error('refusing to overwrite ' + str(out))
+    out.mkdir(parents=True, exist_ok=True)
+    os.environ.update(HF_HUB_OFFLINE='1', TRANSFORMERS_OFFLINE='1', HF_HOME=str(BASE / 'models/hf-training-cache'),
+                      USE_TF='0', USE_FLAX='0', TOKENIZERS_PARALLELISM='false')
+    import psutil
+    import torch
+    from peft import LoraConfig, PeftModel, get_peft_model
+    from transformers import AutoModelForCausalLM, AutoTokenizer
+
+    def log(event):
+        event = {'at': datetime.now(timezone.utc).isoformat(timespec='seconds'), **event}
+        with (out / 'metrics.jsonl').open('a', encoding='utf-8') as handle:
+            handle.write(json.dumps(event) + '\n')
+        print(json.dumps(event), flush=True)
+
+    if not torch.cuda.is_available() or not torch.cuda.is_bf16_supported():
+        log({'status': 'blocked', 'reason': 'CUDA with BF16 is required; no silent CPU fallback'})
+        return 3
+    base_dir = BASE / 'models/qwen-jarvis-base'
+    if sha256_file(base_dir / 'model.safetensors') != BASE_SHA256:
+        raise SystemExit('Base model checksum mismatch; refusing to train on unknown weights.')
+    manifest_sha = sha256_file(args.dataset / 'manifest.json')
+    config = {k: v for k, v in vars(args).items() if k not in {'resume', 'out', 'dataset', 'max_steps', 'max_minutes',
+                                                               'ignore_foreground'}}
+    run = {'state_version': STATE_VERSION, 'base_model': MODEL, 'base_revision': REVISION, 'base_sha256': BASE_SHA256,
+           'dataset': str(args.dataset), 'dataset_manifest_sha256': manifest_sha, 'config': config,
+           'versions': {'torch': torch.__version__, 'cuda': torch.version.cuda, 'gpu': torch.cuda.get_device_name(0)}}
+    if args.resume:
+        stored = json.loads((out / 'run.json').read_text(encoding='utf-8'))
+        for key in ('base_sha256', 'dataset_manifest_sha256', 'config'):
+            if stored[key] != run[key]:
+                raise SystemExit('Resume mismatch in ' + key + '; refusing to mix runs.')
+    else:
+        (out / 'run.json').write_text(json.dumps(run, indent=1), encoding='utf-8')
+
+    examples = load_examples(args.dataset, 'train')
+    tokenizer = AutoTokenizer.from_pretrained(base_dir, local_files_only=True)
+    from jarvis.azr_tasks import SYSTEM
+
+    def encode(example):
+        messages = [{'role': 'system', 'content': SYSTEM}, {'role': 'user', 'content': example['prompt']}]
+        prefix = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
+        full = tokenizer.apply_chat_template(messages + [{'role': 'assistant', 'content': example['target']}], tokenize=False)
+        ids = tokenizer(full, add_special_tokens=False)['input_ids']
+        cut = len(tokenizer(prefix, add_special_tokens=False)['input_ids'])
+        if len(ids) > args.max_len:
+            return None
+        return ids, cut
+
+    encoded = [(e['id'], encode(e)) for e in examples]
+    skipped = [i for i, e in encoded if e is None]
+    encoded = [(i, e) for i, e in encoded if e is not None]
+    torch.manual_seed(args.seed)
+    model = AutoModelForCausalLM.from_pretrained(base_dir, torch_dtype=torch.bfloat16, attn_implementation='sdpa',
+                                                 local_files_only=True).to('cuda')
+    model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={'use_reentrant': False})
+    model.enable_input_require_grads()
+    model.config.use_cache = False
+    checkpoints = sorted(out.glob('checkpoint-*'), key=lambda p: int(p.name.split('-')[1]))
+    if args.resume and checkpoints:
+        model = PeftModel.from_pretrained(model, checkpoints[-1], is_trainable=True, local_files_only=True)
+    else:
+        model = get_peft_model(model, LoraConfig(r=args.lora_r, lora_alpha=2 * args.lora_r, lora_dropout=0.05,
+                                                 target_modules=['q_proj', 'k_proj', 'v_proj', 'o_proj', 'gate_proj',
+                                                                 'up_proj', 'down_proj'], task_type='CAUSAL_LM'))
+    params = [p for p in model.parameters() if p.requires_grad]
+    optimizer = torch.optim.AdamW(params, lr=args.lr, weight_decay=0.0)
+    warmup = max(1, args.max_steps // 10)
+    scheduler = torch.optim.lr_scheduler.LambdaLR(
+        optimizer, lambda step: min(1.0, (step + 1) / warmup) * max(0.1, 1 - step / args.max_steps))
+    step, position, order = 0, 0, None
+    rng = random.Random(args.seed)
+    if args.resume and checkpoints:
+        state = torch.load(checkpoints[-1] / 'trainer-state.pt', map_location='cpu', weights_only=False)
+        optimizer.load_state_dict(state['optimizer'])
+        scheduler.load_state_dict(state['scheduler'])
+        torch.set_rng_state(state['torch_rng'])
+        torch.cuda.set_rng_state_all(state['cuda_rng'])
+        rng.setstate(state['python_rng'])
+        step, position, order = state['step'], state['position'], state['order']
+        log({'status': 'resumed', 'step': step, 'checkpoint': checkpoints[-1].name})
+    if order is None:
+        order = [i for i, _ in encoded]
+        rng.shuffle(order)
+    by_id = dict(encoded)
+
+    def checkpoint(reason):
+        target = out / f'checkpoint-{step}'
+        temporary = out / f'.checkpoint-{step}.tmp'
+        if temporary.exists():
+            shutil.rmtree(temporary)
+        model.save_pretrained(temporary, safe_serialization=True)
+        torch.save({'optimizer': optimizer.state_dict(), 'scheduler': scheduler.state_dict(),
+                    'torch_rng': torch.get_rng_state(), 'cuda_rng': torch.cuda.get_rng_state_all(),
+                    'python_rng': rng.getstate(), 'step': step, 'position': position, 'order': order,
+                    'state_version': STATE_VERSION}, temporary / 'trainer-state.pt')
+        if target.exists():
+            shutil.rmtree(target)
+        temporary.rename(target)
+        for old in sorted(out.glob('checkpoint-*'), key=lambda p: int(p.name.split('-')[1]))[:-2]:
+            shutil.rmtree(old)  # keep the two newest checkpoints
+        log({'event': 'checkpoint', 'step': step, 'reason': reason,
+             'adapter_sha256': sha256_file(target / 'adapter_model.safetensors')})
+
+    started = time.monotonic()
+    process = psutil.Process()
+    torch.cuda.reset_peak_memory_stats()
+    log({'status': 'training', 'examples': len(encoded), 'skipped_too_long': len(skipped), 'trainable_parameters':
+         sum(p.numel() for p in params), 'start_step': step, 'max_steps': args.max_steps})
+    status = 'completed'
+    model.train()
+    while step < args.max_steps:
+        if (out / 'STOP').exists():
+            status = 'cancelled'
+            break
+        if not args.ignore_foreground and foreground_gpu_busy():
+            status = 'preempted'
+            break
+        if (time.monotonic() - started) / 60 > args.max_minutes:
+            status = 'time_budget'
+            break
+        losses, step_started = [], time.monotonic()
+        try:
+            for _ in range(args.grad_accum):
+                ids, cut = by_id[order[position % len(order)]]
+                position += 1
+                tensor = torch.tensor([ids], device='cuda')
+                labels = tensor.clone()
+                labels[0, :cut] = -100
+                with torch.autocast('cuda', dtype=torch.bfloat16):
+                    loss = model(input_ids=tensor, attention_mask=torch.ones_like(tensor), labels=labels).loss
+                if not torch.isfinite(loss):
+                    raise RuntimeError('non-finite loss')
+                (loss / args.grad_accum).backward()
+                losses.append(float(loss.detach()))
+            torch.nn.utils.clip_grad_norm_(params, 1.0)
+            optimizer.step()
+            scheduler.step()
+            optimizer.zero_grad(set_to_none=True)
+        except KeyboardInterrupt:
+            status = 'cancelled'
+            optimizer.zero_grad(set_to_none=True)
+            break
+        step += 1
+        peak_vram = torch.cuda.max_memory_allocated() / 2 ** 20
+        rss = process.memory_info().rss / 2 ** 20
+        log({'step': step, 'loss': round(sum(losses) / len(losses), 5), 'lr': scheduler.get_last_lr()[0],
+             'seconds': round(time.monotonic() - step_started, 2), 'peak_vram_mb': round(peak_vram), 'rss_mb': round(rss)})
+        if peak_vram > args.vram_limit_mb or rss > args.ram_limit_mb:
+            status = 'resource_limit'
+            break
+        if step % args.checkpoint_every == 0:
+            checkpoint('interval')
+    checkpoint(status)
+    final = {'status': status, 'step': step, 'minutes': round((time.monotonic() - started) / 60, 2),
+             'peak_vram_mb': round(torch.cuda.max_memory_allocated() / 2 ** 20)}
+    (out / 'final.json').write_text(json.dumps(final, indent=1), encoding='utf-8')
+    log(final)
+    return 0 if status == 'completed' else 2
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
