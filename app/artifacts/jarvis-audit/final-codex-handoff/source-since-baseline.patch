+def vault_hash(vault):
+    digest = hashlib.sha256()
+    for path in sorted(vault.rglob('*')):
+        if path.is_file():
+            digest.update(str(path.relative_to(vault)).encode() + path.read_bytes())
+    return digest.hexdigest()
+
