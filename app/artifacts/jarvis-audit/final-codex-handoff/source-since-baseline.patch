+    def _record(self, row):
+        self.log.parent.mkdir(parents=True, exist_ok=True)
+        with self.log.open('a', encoding='utf-8') as output:
+            output.write(json.dumps({'at': now().isoformat(timespec='seconds'), **row}, ensure_ascii=False) + '\n')
