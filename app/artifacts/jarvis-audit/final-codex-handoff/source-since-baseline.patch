+    folder = Path(base) / '.jarvis-runtime' / 'cloud' / 'advice' / uuid.uuid4().hex[:12]
+    folder.mkdir(parents=True, exist_ok=True)
+    (folder / 'server.py').write_text(HARNESS, encoding='utf-8')  # harness is Jarvis-owned; advice arrives as data
