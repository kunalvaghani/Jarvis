+    paid = {**OPTIONS, 'groq': {**OPTIONS['groq'], 'account_plan': 'paid'}}
+    agent, adapter = architect(tmp_path, options=paid)
+    result = agent.consult('p2', GENERIC, FAILURES, 3, 'r1')
