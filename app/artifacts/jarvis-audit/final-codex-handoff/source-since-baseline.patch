diff --git a/app/jarvis/office_com_worker.py b/app/jarvis/office_com_worker.py
new file mode 100644
index 0000000..2cf1c85
--- /dev/null
+++ b/app/jarvis/office_com_worker.py
@@ -0,0 +1,119 @@
+"""One-shot native Office automation worker (main .venv, pywin32).
+
+Opens a host-prepared temporary copy in a *new*, hidden Excel or Word instance
+(DispatchEx), edits it through the application's own object model, saves it with
+the application itself (so features openpyxl/python-docx cannot round-trip, such
+as macros and charts, are preserved by Office) and quits. The owned process ID
+is written to the host's PID file before any edit so a timed-out instance can be
+stopped without touching the user's own Office windows.
+"""
+import json
+import re
+import sys
+import uuid
+
+LIMIT = 1_000_000
+CELL = re.compile(r'[A-Z]{1,3}[1-9][0-9]{0,6}')
+
+
+def _owned_pid(application, kind):
+    import win32gui
+    import win32process
+    if kind == 'excel':
+        handle = application.Hwnd
+    else:
+        caption = 'Jarvis-owned-' + uuid.uuid4().hex
+        application.Caption = caption
+        handle = win32gui.FindWindow('OpusApp', caption)
+    if not handle:
+        raise RuntimeError('Owned Office window was not found.')
+    return win32process.GetWindowThreadProcessId(handle)[1]
+
+
+def excel_write(application, request):
+    book = application.Workbooks.Open(request['path'], UpdateLinks=0, ReadOnly=False)
+    try:
+        sheet = book.Worksheets(request['sheet'])
+        for coordinate, value in request['cells'].items():
+            if not CELL.fullmatch(coordinate):
+                raise ValueError('Cells must be A1-style coordinates.')
+            cell = sheet.Range(coordinate)
+            if isinstance(value, str) and value.startswith('='):
+                cell.Formula = value
+            else:
+                cell.Value = value
+        application.Calculate()
+        result = {coordinate: sheet.Range(coordinate).Value for coordinate in request['cells']}
+        book.Save()
+        return {'written': sorted(request['cells']), 'calculated': result}
+    finally:
+        book.Close(SaveChanges=False)
+
+
+def word_write(application, request):
+    document = application.Documents.Open(request['path'], ConfirmConversions=False, ReadOnly=False,
+                                          AddToRecentFiles=False, Visible=False)
+    try:
+        for edit in request['edits']:
+            if edit['kind'] == 'append_paragraph':
+                document.Content.InsertParagraphAfter()
+                document.Paragraphs(document.Paragraphs.Count).Range.Text = edit['text']
+            elif edit['kind'] == 'replace_text':
+                find = document.Content.Find
+                find.ClearFormatting()
+                find.Replacement.ClearFormatting()
+                # Late-bound COM ignores named Execute arguments, so set properties explicitly.
+                find.Text, find.Replacement.Text = edit['find'], edit['replace']
+                find.Forward, find.Wrap, find.MatchCase = True, 0, True  # wdFindStop; exact case
+                find.MatchWholeWord = find.MatchWildcards = False
+                # Positional Execute: 11th argument Replace=wdReplaceAll (2).
+                if not find.Execute(edit['find'], True, False, False, False, False, True, 0, False,
+                                    edit['replace'], 2):
+                    raise ValueError('Text not found; no change made.')
+            else:
+                raise ValueError('Unsupported Word edit.')
+        document.Save()
+        return {'edits': len(request['edits'])}
+    finally:
+        document.Close(SaveChanges=False)
+
+
+def main():
+    application = None
+    try:
+        raw = sys.stdin.buffer.read(LIMIT + 1)
+        if len(raw) > LIMIT:
+            raise ValueError('Office request exceeds 1 MB.')
+        request = json.loads(raw)
+        kind = request['application']
+        if kind not in {'excel', 'word'}:
+            raise ValueError('Unsupported Office application.')
+        import pythoncom
+        import win32com.client
+        pythoncom.CoInitialize()
+        application = win32com.client.DispatchEx('Excel.Application' if kind == 'excel' else 'Word.Application')
+        application.Visible = False
+        application.DisplayAlerts = False if kind == 'excel' else 0
+        if kind == 'excel':
+            application.AskToUpdateLinks = False
+            application.EnableEvents = False  # Workbook event macros never run during automation.
+            application.AutomationSecurity = 3  # msoAutomationSecurityForceDisable: macros preserved, not executed.
+        else:
+            application.AutomationSecurity = 3
+        with open(request['pid_file'], 'w', encoding='ascii') as handle:
+            handle.write(str(_owned_pid(application, kind)))
+        value = (excel_write if kind == 'excel' else word_write)(application, request)
+        text = json.dumps({'ok': True, 'value': value}, default=str, allow_nan=False)
+    except Exception as error:
+        text = json.dumps({'ok': False, 'error_type': type(error).__name__, 'error': str(error)[:500]})
+    finally:
+        if application is not None:
+            try:
+                application.Quit()
+            except Exception:  # The host stops the owned PID if Quit did not complete.
+                pass
+    sys.stdout.write(text)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/app/jarvis/prompt_evolution.py b/app/jarvis/prompt_evolution.py
new file mode 100644
index 0000000..e1e6c63
--- /dev/null
+++ b/app/jarvis/prompt_evolution.py
@@ -0,0 +1,165 @@
+"""EEVEE-style router/prompt co-evolution for ``jarvis.prompt_router`` (Pillar C, Part C).
+
+Follows the method described in EEVEE (arXiv 2606.11182; Princeton-AI2-Lab/EEVEE, Apache-2.0):
+alternate a router phase (prompts fixed) and a prompt phase (router fixed); split the training
+partition into a mini-batch half and a validation half; anneal router scoring from
+consistency/balance toward accuracy; keep a per-example Pareto front of slot prompts and an
+empty-prompt floor (a prompt must beat no prompt). No EEVEE code is copied.
+
+Only the train split (``evolution_eval/train``) is used here. Winners become archive
+candidates that the sealed gate re-tests on held-out data; nothing here edits production.
+"""
+import json
+import math
+import random
+import urllib.request
+
+from .evolution_surfaces import SURFACES, UNSAFE_TEXT, validate
+from .prompt_router import ROUTER, SLOT_PROMPTS, SLOTS, route
+
+REFLECTION_LIBRARY = {
+    'tool_selection': ('Prefer the dedicated API or adapter tool named for the task over generic UI tools.',
+                       'Choose the tool whose name matches the object being changed (file, cell, track, repository).',
+                       'Generic input tools such as scroll or type_text are a last resort.'),
+    'planning': ('Order steps so prerequisites come first and verify each result before the next step.',),
+    'coding': ('Read the relevant files and tests first, change the smallest unit, then run the tests.',),
+    'ui_automation': ('Use structured controls by name before coordinates and confirm the window changed.',),
+    'knowledge': ('Answer from retrieved sources and say when a source is missing.',),
+    'error_recovery': ('Inspect the current state before retrying and never repeat an uncertain write.',),
+}
+
+
+def halves(cases):
+    """EEVEE reserves half of the training partition for validation."""
+    return cases[0::2], cases[1::2]
+
+
+def router_score(weights, cases, alpha):
+    """Annealed objective: alpha * accuracy + (1 - alpha) * slot-balance (normalized entropy)."""
+    routed = [route(case['goal'], weights=weights) for case in cases]
+    accuracy = sum(r == case['slot'] for r, case in zip(routed, cases)) / len(cases)
+    counts = [routed.count(slot) for slot in SLOTS if routed.count(slot)]
+    total = sum(counts)
+    entropy = -sum(c / total * math.log(c / total) for c in counts) / math.log(len(SLOTS)) if total else 0.
+    return alpha * accuracy + (1 - alpha) * entropy, accuracy
+
+
+def ollama_solver(model, url='http://127.0.0.1:11434/api/generate', timeout=120):
+    """Local-only solver for multiple-choice cases; temperature 0 and a fixed seed."""
+    def solve(prompt, case):
+        question = case['question'] + '\n' + '\n'.join(f'{k}) {v}' for k, v in case['choices'].items()) + '\nAnswer:'
+        body = json.dumps({'model': model, 'system': prompt or 'Answer with a single letter.', 'prompt': question,
+                           'stream': False, 'think': False, 'options': {'temperature': 0, 'seed': 7, 'num_predict': 8}}).encode()
+        request = urllib.request.Request(url, body, {'Content-Type': 'application/json'})
+        with urllib.request.urlopen(request, timeout=timeout) as response:
+            text = json.loads(response.read())['response'].strip().upper()
+        return next((ch for ch in text if ch in case['choices']), '') == case['answer']
+    return solve
+
+
+def ollama_reflector(model, url='http://127.0.0.1:11434/api/generate', timeout=300):
+    """Local-model reflection: one short guidance sentence from failed train examples (no private data)."""
+    def reflect(slot, current, failures):
+        shown = '\n'.join(f"- {f['question']} (correct: {f['choices'][f['answer']]})" for f in failures[:4])
+        prompt = (f'You write one short instruction (under 40 words) that helps a small model choose the right tool. '
+                  f'Current instruction: "{current}". Questions it got wrong:\n{shown}\n'
+                  'Reply with only the improved instruction.')
+        body = json.dumps({'model': model, 'prompt': prompt, 'stream': False, 'think': False,
+                           'options': {'temperature': 0, 'seed': 11, 'num_predict': 80}}).encode()
+        request = urllib.request.Request(url, body, {'Content-Type': 'application/json'})
+        with urllib.request.urlopen(request, timeout=timeout) as response:
+            text = json.loads(response.read())['response'].strip().strip('"')
+        return ' '.join(text.split())[:600]
+    return reflect
+
+
+class PromptCoEvolution:
+    def __init__(self, research, solver=None, reflect=None, rng=None):
+        self.research = research
+        self.solver = solver
+        self.reflect = reflect
+        self.rng = rng or random.Random(0)
+
+    # ---- router phase (prompts fixed) --------------------------------------------------------------------------------
+    def router_phase(self, rounds=12):
+        cases = self.research.gate.data('prompt_routing', 'train')['cases']
+        batch, validation = halves(cases)
+        best = dict(ROUTER)
+        best_score, _ = router_score(best, validation, 1.)
+        history = []
+        bounds = SURFACES['prompt_router']['bounds']
+        for step in range(rounds):
+            alpha = .5 + .5 * step / max(1, rounds - 1)  # anneal from balance toward accuracy
+            candidate = dict(best)
+            key = self.rng.choice(sorted(bounds))
+            _, low, high = bounds[key]
+            candidate[key] = round(min(high, max(low, candidate[key] + (high - low) * self.rng.choice([-.1, .1, -.2, .2]))), 4)
+            validate('prompt_router', candidate)
+            mini, _ = router_score(candidate, batch, alpha)
+            parent_mini, _ = router_score(best, batch, alpha)
+            if mini < parent_mini:
+                history.append({'step': step, 'key': key, 'accepted': False, 'reason': 'mini-batch'})
+                continue
+            score, accuracy = router_score(candidate, validation, 1.)
+            accepted = score > best_score
+            history.append({'step': step, 'key': key, 'value': candidate[key], 'validation_accuracy': accuracy,
+                            'accepted': accepted})
+            if accepted:
+                best, best_score = candidate, score
+        return best, best_score, history
+
+    # ---- prompt phase (router fixed) ---------------------------------------------------------------------------------
+    def evaluate_prompt(self, prompt, cases):
+        return [bool(self.solver(prompt, case)) for case in cases]
+
+    def prompt_phase(self, slot, rounds=3):
+        if self.solver is None:
+            raise RuntimeError('Prompt evolution needs a solver (a local model); report as BLOCKED when unavailable.')
+        cases = [c for c in self.research.gate.data('prompt_slots', 'train')['cases'] if route(c['question']) == slot]
+        if len(cases) < 2:
+            return None, {'reason': 'too few routed train cases for slot ' + slot}
+        batch, validation = halves(cases)
+        floor = self.evaluate_prompt('', validation)  # empty-prompt floor
+        front = [('', floor)]
+        current = SLOT_PROMPTS.get(slot, '')
+        history = []
+        library = list(REFLECTION_LIBRARY.get(slot, ()))
+        for step in range(rounds):
+            outcomes = self.evaluate_prompt(current, batch)
+            failures = [case for case, ok in zip(batch, outcomes) if not ok]
+            proposal = None
+            if self.reflect is not None and failures:
+                try:
+                    proposal = self.reflect(slot, current, failures)
+                except Exception as exc:
+                    history.append({'step': step, 'reflection_error': type(exc).__name__})
+            if not proposal and library:
+                proposal = (current + ' ' + library.pop(0)).strip()
+            if not proposal or UNSAFE_TEXT.search(proposal) or not proposal.isascii():
+                history.append({'step': step, 'rejected': 'unsafe, empty or non-ASCII proposal'})
+                continue
+            scores = self.evaluate_prompt(proposal, validation)
+            beats_floor = sum(scores) > sum(floor)
+            dominated = any(all(a >= b for a, b in zip(other, scores)) and other != scores for _, other in front)
+            history.append({'step': step, 'prompt': proposal, 'validation_correct': sum(scores), 'floor': sum(floor),
+                            'beats_empty_floor': beats_floor, 'dominated': dominated})
+            if beats_floor and not dominated:
+                front = [(p, s) for p, s in front if not (all(a >= b for a, b in zip(scores, s)) and scores != s)]
+                front.append((proposal, scores))
+                current = proposal
+        best = max((p for p in front if p[0]), key=lambda item: sum(item[1]), default=None)
+        return (best[0] if best else None), {'history': history, 'front': [{'prompt': p, 'correct': sum(s)} for p, s in front],
+                                             'cases': len(cases)}
+
+    # ---- hand winners to the gate ------------------------------------------------------------------------------------
+    def submit(self, surface, values, statement, cancelled=lambda: False):
+        research = self.research
+        validate(surface, values)
+        seed = research.seed(surface)
+        from .evolution_surfaces import digest, distance
+        if research.archive.diversity(surface, values, distance) == 0:
+            return {'decision': 'duplicate', 'reason': 'already archived'}
+        identifier = research.archive.add(surface, values, digest(values), seed['source_commit'], seed['id'],
+                                          'eevee_' + surface, {'from': seed['values'], 'to': values}, [SURFACES[surface]['file']],
+                                          statement, 'running', None, research.gate.environment())
+        return research.evaluate_candidate(identifier, seed, cancelled)
diff --git a/app/jarvis/prompt_router.py b/app/jarvis/prompt_router.py
new file mode 100644
index 0000000..6ab562c
--- /dev/null
+++ b/app/jarvis/prompt_router.py
@@ -0,0 +1,83 @@
+"""EEVEE-inspired task-specialized prompt routing for the local planner.
+
+Adapted from the method of EEVEE (Princeton-AI2-Lab/EEVEE, Apache-2.0; arXiv 2606.11182):
+inputs are routed to one of a few prompt slots, and the router and the slot prompts are
+improved in alternating phases under validation feedback, keeping a Pareto front of
+complementary prompts and an empty-prompt floor. No EEVEE code is copied. Differences:
+
+- The router is a deterministic weighted keyword classifier, not an LLM router prompt, so
+  routing costs microseconds and is reproducible. Its weights are the ``ROUTER`` surface.
+- Deterministic voice commands never reach this router (``route(..., deterministic=True)``
+  returns None), so direct commands are not sent through an LLM.
+- Slot prompts start empty (the empty-prompt floor), so production behaviour is unchanged
+  until an evolved slot prompt passes the retention gate and the user approves it.
+- Routing and slot guidance are independent of security rules: guidance is advisory text
+  inside ``capability_context`` and can never grant approval or change tool permissions.
+"""
+import re
+
+SLOTS = ('planning', 'coding', 'ui_automation', 'knowledge', 'tool_selection', 'error_recovery')
+
+# Router weights and slot prompts are bounded evolution surfaces (jarvis/evolution_surfaces.py).
+ROUTER = {'keyword_weight': 1.0, 'phrase_weight': 2.0, 'tool_name_weight': 1.0, 'min_score': 1.0}
+SLOT_PROMPTS = {'planning': '', 'coding': '', 'ui_automation': '', 'knowledge': '', 'tool_selection': '',
+                'error_recovery': ''}
+
+KEYWORDS = {
+    'planning': ('plan', 'steps', 'organize', 'schedule', 'prepare', 'workflow', 'then', 'after', 'first', 'multi'),
+    'coding': ('code', 'python', 'script', 'function', 'bug', 'refactor', 'test', 'compile', 'repository', 'debug'),
+    'ui_automation': ('click', 'button', 'window', 'menu', 'dialog', 'type', 'field', 'textbox', 'tab', 'scroll'),
+    'knowledge': ('what', 'why', 'explain', 'research', 'learn', 'documentation', 'remember', 'notes', 'summarize', 'find'),
+    'tool_selection': ('tool', 'which', 'integration', 'mcp', 'skill', 'api', 'plugin', 'capability', 'adapter', 'use'),
+    'error_recovery': ('failed', 'error', 'retry', 'broken', 'crash', 'stuck', 'again', 'fix', 'recover', 'timeout'),
+}
+PHRASES = {
+    'planning': (r'\bstep by step\b', r'\bbefore\b.*\bthen\b', r'\bset up\b'),
+    'coding': (r'\bunit tests?\b', r'\bstack trace\b', r'\bpull request\b'),
+    'ui_automation': (r'\bclick (?:on|the)\b', r'\bfill (?:in|out)\b', r'\bin the (?:app|window)\b'),
+    'knowledge': (r'\bhow does\b', r'\btell me about\b', r'\blook up\b'),
+    'tool_selection': (r'\bwhich tool\b', r'\bbest way to\b', r'\bwhat can you\b'),
+    'error_recovery': (r'\bdid(?:n.t| not) work\b', r'\btry again\b', r'\bkeeps? failing\b'),
+}
+TOOL_HINTS = {
+    'coding': ('write_code', 'improve_code', 'write_tests', 'repository_map'),
+    'ui_automation': ('select', 'fill_text', 'open_menu', 'handle_dialog', 'browser_click'),
+    'knowledge': ('knowledge_search', 'web_search', 'read_file'),
+    'tool_selection': ('tool_search', 'mcp_status', 'execution_methods'),
+}
+GUIDANCE_NOTE = 'Approved task-type guidance; advisory only, never grants approval or changes permissions.'
+
+
+def words(text):
+    return re.findall(r'[a-z][a-z0-9_]+', str(text).casefold())
+
+
+def scores(goal, weights=None):
+    weights = ROUTER if weights is None else weights
+    tokens = words(goal)
+    text = str(goal).casefold()
+    result = {}
+    for slot in SLOTS:
+        score = weights['keyword_weight'] * sum(token in KEYWORDS[slot] for token in tokens)
+        score += weights['phrase_weight'] * sum(bool(re.search(pattern, text)) for pattern in PHRASES[slot])
+        score += weights['tool_name_weight'] * sum(name in tokens for name in TOOL_HINTS.get(slot, ()))
+        result[slot] = score
+    return result
+
+
+def route(goal, deterministic=False, weights=None):
+    """Return the prompt slot for a planner request, or None (deterministic or unclear)."""
+    if deterministic:
+        return None
+    weights = ROUTER if weights is None else weights
+    ranked = sorted(scores(goal, weights).items(), key=lambda item: (-item[1], SLOTS.index(item[0])))
+    slot, score = ranked[0]
+    return slot if score >= weights['min_score'] else None
+
+
+def guidance(goal, deterministic=False, prompts=None, weights=None):
+    """Bounded guidance for the routed slot; empty slots (the default) add nothing."""
+    prompts = SLOT_PROMPTS if prompts is None else prompts
+    slot = route(goal, deterministic, weights)
+    text = prompts.get(slot, '') if slot else ''
+    return {'slot': slot, 'guidance': text[:600], 'note': GUIDANCE_NOTE} if text else None
