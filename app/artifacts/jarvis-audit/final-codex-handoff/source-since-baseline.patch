+    calls = [{'id': 's1', 'tool': 'append_file', 'args': {'path': 'docs/a.txt', 'text': 'y'}},
+             {'id': 's2', 'tool': 'delete_file', 'args': {'path': 'docs/missing.txt'}},
+             {'id': 's3', 'tool': 'create_file', 'args': {'path': 'docs/b.txt', 'content': 'z'}}]
+    final = execute(initial, calls)
