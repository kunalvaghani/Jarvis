diff --git a/app/integrations/jarvis-connectors/connectors/apps/blender/client_smoke.py b/app/integrations/jarvis-connectors/connectors/apps/blender/client_smoke.py
new file mode 100644
index 0000000..254ee7f
--- /dev/null
+++ b/app/integrations/jarvis-connectors/connectors/apps/blender/client_smoke.py
@@ -0,0 +1,32 @@
+"""Real stdio discovery client; default mode lists schemas and never edits Blender."""
+import argparse
+import json
+from pathlib import Path
+import sys
+
+HERE=Path(__file__).resolve().parent
+sys.path.insert(0,str(HERE.parents[4]))
+from jarvis.mcp_bridge import StdioClient
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--bridge-config',default=str(HERE.parents[4]/'.jarvis-runtime/blender/unconfigured.json'))
+    parser.add_argument('--live-health',action='store_true')
+    options=parser.parse_args()
+    inventory=json.loads((HERE/'catalog.json').read_text())
+    config={'enabled':True,'trusted':True,'approval_binding':'blender-v1','command':sys.executable,
+        'args':[str(HERE/'server.py'),'--runtime','builtin','--allow-write','--bridge-config',str(Path(options.bridge_config).resolve())],
+        'allow_tools':[r['tool'] for r in inventory],'timeout_seconds':15}
+    client=StdioClient(config,HERE,lambda:False)
+    try:
+        client.initialize();rows=client.tools()
+        assert len(rows)==203
+        assert {r['name'] for r in rows}==set(config['allow_tools'])
+        report={'runtime':'Jarvis builtin MCP 2025-11-25, real stdio','count':len(rows),'names':[r['name'] for r in rows]}
+        if options.live_health:report['live_health']=client.request('tools/call',{'name':'blender_bridge_health','arguments':{}})
+        print(json.dumps(report,indent=2))
+    finally:client.close()
+
+
+if __name__=='__main__':main()
diff --git a/app/integrations/jarvis-connectors/connectors/apps/blender/launch_blender.ps1 b/app/integrations/jarvis-connectors/connectors/apps/blender/launch_blender.ps1
new file mode 100644
index 0000000..0696ca8
--- /dev/null
+++ b/app/integrations/jarvis-connectors/connectors/apps/blender/launch_blender.ps1
@@ -0,0 +1,28 @@
+param(
+  [Parameter(Mandatory=$true)][string]$BlenderExe,
+  [Parameter(Mandatory=$true)][string[]]$AllowedRoots,
+  [string]$ProjectPath = '',
+  [int]$Port = 8769,
+  [Parameter(Mandatory=$true)][string]$BridgeConfig
+)
+$ErrorActionPreference = 'Stop'
+if (-not (Test-Path -LiteralPath $BlenderExe -PathType Leaf)) { throw 'Blender.exe not found at provided path.' }
+$resolved = @()
+foreach($path in $AllowedRoots) {
+  if (-not (Test-Path -LiteralPath $path -PathType Container)) { throw "Allowed directory does not exist: $path" }
+  $resolved += (Resolve-Path -LiteralPath $path).Path
+}
+$env:JARVIS_BLENDER_ALLOWED_ROOTS = ($resolved -join ';')
+$env:JARVIS_BLENDER_PORT = [string]$Port
+$env:JARVIS_BLENDER_CONFIG = [IO.Path]::GetFullPath($BridgeConfig)
+if (Test-Path -LiteralPath $env:JARVIS_BLENDER_CONFIG) { throw 'Scope file already exists. Attach explicitly or stop that instance first; never overwrite another scope.' }
+$blenderArgs = @('--disable-autoexec')
+if ($ProjectPath) {
+    if (-not (Test-Path -LiteralPath $ProjectPath -PathType Leaf)) { throw 'Project file does not exist.' }
+    $project = (Resolve-Path -LiteralPath $ProjectPath).Path
+    if ([IO.Path]::GetExtension($project) -ne '.blend') { throw 'Project must be a .blend file.' }
+    $blenderArgs += $project
+}
+$blenderArgs += @('--python', (Join-Path $PSScriptRoot 'start_blender_bridge.py'))
+Write-Host "Starting Blender bridge on 127.0.0.1:$Port"
+Start-Process -FilePath $BlenderExe -ArgumentList ($blenderArgs | ForEach-Object { '"' + $_ + '"' }) -WindowStyle Hidden
diff --git a/app/integrations/jarvis-connectors/connectors/apps/blender/live_bridge_fixture.py b/app/integrations/jarvis-connectors/connectors/apps/blender/live_bridge_fixture.py
new file mode 100644
index 0000000..36a1ae0
--- /dev/null
+++ b/app/integrations/jarvis-connectors/connectors/apps/blender/live_bridge_fixture.py
@@ -0,0 +1,21 @@
+"""Owned disposable background Blender instance for host/stdio E2E verification only."""
+import os
+from pathlib import Path
+import time
+import sys
+sys.path.insert(0,str(Path(__file__).resolve().parent))
+import bpy
+from blender_connector.bridge import Bridge
+
+config=Path(os.environ['JARVIS_BLENDER_CONFIG'])
+bpy.ops.wm.read_factory_settings(use_empty=True)
+for name,size,offset in [('Medium',125,0),('Large',500,3)]:
+    bpy.ops.mesh.primitive_grid_add(x_subdivisions=size,y_subdivisions=size,location=(offset,0,0))
+    bpy.context.object.name=name
+bridge=Bridge(port=int(os.environ['JARVIS_BLENDER_PORT'])).start()
+deadline=time.monotonic()+300
+try:
+    while time.monotonic()<deadline and not config.with_suffix('.stop').exists():
+        bridge.pump()
+        time.sleep(.01)
+finally:bridge.stop()
diff --git a/app/integrations/jarvis-connectors/connectors/apps/blender/render_live.py b/app/integrations/jarvis-connectors/connectors/apps/blender/render_live.py
new file mode 100644
index 0000000..b0e784b
--- /dev/null
+++ b/app/integrations/jarvis-connectors/connectors/apps/blender/render_live.py
@@ -0,0 +1,51 @@
+"""Tiny disposable Cycles CPU/GPU rendering acceptance with actual image readback."""
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+import time
+sys.path.insert(0,str(Path(__file__).resolve().parent))
+import bpy
+from blender_connector.operations import BlenderOperations
+
+folder=Path(tempfile.mkdtemp(prefix='jarvis-cycles-audit-'))
+os.environ['JARVIS_BLENDER_ALLOWED_ROOTS']=str(folder)
+bpy.ops.wm.read_factory_settings(use_empty=False)
+ops=BlenderOperations()
+ops.execute('set_render_engine',{'engine':'CYCLES'})
+ops.execute('set_render_resolution',{'width':64,'height':64})
+ops.execute('set_render_samples',{'samples':1})
+report={'version':bpy.app.version_string,'renders':[]}
+preferences=bpy.context.preferences.addons['cycles'].preferences
+preferences.get_devices()
+devices=[{'name':d.name,'type':d.type} for d in preferences.devices]
+report['initial_devices']=devices
+for mode in ('CPU','GPU'):
+    record={'device':mode}
+    try:
+        if mode=='GPU':
+            found=False
+            for backend in ('OPTIX','CUDA','HIP','ONEAPI','METAL'):
+                try:
+                    preferences.compute_device_type=backend;preferences.get_devices()
+                    selected=[d for d in preferences.devices if d.type==backend]
+                    if not selected:continue
+                    for d in preferences.devices:d.use=d.type==backend
+                    record['backend']=backend;record['devices']=[d.name for d in selected];found=True;break
+                except (TypeError,ValueError):continue
+            if not found:raise RuntimeError('No available Cycles GPU backend')
+        ops.execute('set_cycles_device',{'device':mode})
+        path=folder/(mode.lower()+'.png')
+        start=time.perf_counter();ops.execute('render_still',{'filepath':str(path)});record['elapsed_ms']=(time.perf_counter()-start)*1000
+        image=bpy.data.images.load(str(path),check_existing=False)
+        assert tuple(image.size)==(64,64)
+        pixels=list(image.pixels)
+        assert any(pixels[i]>0 for i in range(0,len(pixels),4))
+        record.update(coverage='VERIFIED IN BLENDER',png_bytes=path.stat().st_size,resolution=list(image.size),nonzero_rgb=True)
+        target=Path(os.environ['JARVIS_BLENDER_RENDER_REPORT']).parent/(mode.lower()+'-preview.png')
+        target.write_bytes(path.read_bytes())
+    except Exception as exc:record.update(coverage='UNTESTED',error=str(exc)[:400])
+    report['renders'].append(record)
+Path(os.environ['JARVIS_BLENDER_RENDER_REPORT']).write_text(json.dumps(report,indent=2),encoding='utf-8')
+print('JARVIS_RENDER_AUDIT',report,flush=True)
