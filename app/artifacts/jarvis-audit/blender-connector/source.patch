+"""Autogenerated MCP adapter: every Blender action has its own named tool.
+DO NOT modify manually; regenerate using python generate_server.py.
+Stdout reserved for MCP JSON-RPC; bridge must already be running in Blender.
+"""
+from __future__ import annotations
+from typing import Any
+try:
+    from mcp.server import MCPServer  # official MCP SDK v2
+except ImportError:
+    from mcp.server.fastmcp import FastMCP as MCPServer  # SDK v1 compatibility
+from blender_connector.connector import BlenderConnector
+from blender_connector.catalog import ACTIONS
+from blender_connector.base import ConnectorError
+from typing import Callable
+
+mcp = MCPServer('jarvis-blender')
+
+# Host-side approval must be supplied via Jarvis policy. By default the MCP
+# standalone server denies destructive and filesystem actions. To enable them,
+# inject a host approval_callback after explicit user confirmation.
+connector = BlenderConnector()
+
+@mcp.tool()
+async def blender_health() -> dict:
+    """Check live Blender connection, version and current file. Risk classification: read."""
+    return await connector.execute('health', {}, wait=True)
+
+@mcp.tool()
+async def blender_version() -> dict:
+    """Get installed Blender version and build info. Risk classification: read."""
+    return await connector.execute('version', {}, wait=True)
+
+@mcp.tool()
+async def blender_capabilities() -> dict:
+    """List supported commands and approval classes. Risk classification: read."""
+    return await connector.execute('capabilities', {}, wait=True)
+
+@mcp.tool()
+async def blender_scene_summary() -> dict:
+    """Summarize objects, materials, collections, frame and render settings. Risk classification: read."""
+    return await connector.execute('scene_summary', {}, wait=True)
+
+@mcp.tool()
+async def blender_list_scenes() -> dict:
+    """List scenes. Risk classification: read."""
+    return await connector.execute('list_scenes', {}, wait=True)
+
+@mcp.tool()
+async def blender_list_objects(type: str = '', limit: int = 250) -> dict:
+    """List named objects with optional type filter. Risk classification: read."""
+    return await connector.execute('list_objects', {'type': type, 'limit': limit}, wait=True)
+
+@mcp.tool()
+async def blender_list_materials(limit: int = 250) -> dict:
+    """List materials. Risk classification: read."""
+    return await connector.execute('list_materials', {'limit': limit}, wait=True)
+
+@mcp.tool()
+async def blender_list_images(limit: int = 250) -> dict:
+    """List loaded images. Risk classification: read."""
+    return await connector.execute('list_images', {'limit': limit}, wait=True)
+
+@mcp.tool()
+async def blender_list_actions(limit: int = 250) -> dict:
+    """List animation actions. Risk classification: read."""
+    return await connector.execute('list_actions', {'limit': limit}, wait=True)
+
+@mcp.tool()
+async def blender_list_collections() -> dict:
+    """List collections. Risk classification: read."""
+    return await connector.execute('list_collections', {}, wait=True)
+
+@mcp.tool()
+async def blender_get_object(name: str) -> dict:
+    """Inspect object, transforms and optional mesh statistics. Risk classification: read."""
+    return await connector.execute('get_object', {'name': name}, wait=True)
+
+@mcp.tool()
