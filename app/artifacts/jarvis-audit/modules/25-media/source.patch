+
+def test_JRV_25_010_missing_session_is_honest():
+    with patch.dict(sys.modules, media_modules(FakeManager([]))):
+        with pytest.raises(ValueError, match='no active playback'):
+            asyncio.run(spotify._control('pause', lambda: False))
