# Local compatibility junction; app/ is canonical.
/InsTAREELS/

# Regenerable developer caches; application/runtime data has its own ignore rules.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Private, short-path regression workspaces, outside live application/runtime ancestry.
/.jtmp/

# Backups the skill learner writes before changing .jarvis/mcp.json
app/.jarvis/mcp.json.*.bak
